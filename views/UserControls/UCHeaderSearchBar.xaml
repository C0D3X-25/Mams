<UserControl x:Class="Mams.views.userControls.UCHeaderSearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams.views.userControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--Searchbar-->
    <Grid x:Name="searchbar_grid" Grid.Column="1" Background="#FFE25F5F" MaxWidth="500">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="searchbar_cmbBox" Grid.Column="0" Margin="50,0,0,0" VerticalAlignment="Center"/>
        <TextBox x:Name="searchbar_txtBox" Grid.Column="1" Margin="1,0,50,0" VerticalAlignment="Center"/>
        <ListView x:Name="searchbar_listView" Grid.Column="1" Margin="1,35,50,0" Height="150" VerticalAlignment="Top" Visibility="Hidden"/>
    </Grid>
    <!--Searchbar-->
</UserControl>
