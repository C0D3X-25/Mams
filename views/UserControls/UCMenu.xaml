<UserControl x:Class="Mams.views.userControls.UCMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams.views.userControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!--Menu-->
    <Grid x:Name="menu_grid" Grid.Column="0" Background="#FFB4B4B4" Margin="10,3,3,3">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Menu Buttons-->
        <Grid x:Name="menu_btn_grid" Grid.Column="0" Background="#FFD9D9D9" MinHeight="300" MaxHeight="400" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label x:Name="menu_label" Content="Menu" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="menu_button0" Content="Menu Button" Grid.Row="1" Margin="3"/>
            <Button x:Name="menu_button1" Content="Menu Button" Grid.Row="2" Margin="3"/>
            <Button x:Name="menu_button2" Content="Menu Button" Grid.Row="3" Margin="3"/>
            <Button x:Name="menu_button3" Content="Menu Button" Grid.Row="4" Margin="3"/>
            <Button x:Name="menu_button4" Content="Menu Button" Grid.Row="5" Margin="3"/>
        </Grid>
        <!--Menu Buttons-->
    </Grid>
    <!--Menu-->

</UserControl>
