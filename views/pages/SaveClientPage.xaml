<Page x:Class="Mams.views.pages.SaveClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mams.views.pages"
      xmlns:userControls="clr-namespace:Mams.views.userControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SaveClientsPage">

    <Grid>
        <!--Page is 12* per 12*-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MaxHeight="100"/>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*" MaxHeight="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*"/>
            </Grid.ColumnDefinitions>

            <!--Header-->
            <userControls:UCHeader 
                x:Name="header" 
                Grid.Row="0"
                title="Client">

            </userControls:UCHeader>

            <!--Body-->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="200"/>
                    <!--For menu-->
                    <ColumnDefinition Width="10*"/>
                    <!--For content-->
                </Grid.ColumnDefinitions>

                <!--Menu-->
                <userControls:UCMenu 
                    x:Name="pages_menu">

                </userControls:UCMenu>

                <!--Content-->
                <Grid Grid.Column="1" 
                      Background="#FFE0A5A5" 
                      Margin="3,3,10,3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="9*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!--Fields-->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!--Left Grid-->
                            <Grid Grid.Column="0" Grid.Row="1" 
                                  HorizontalAlignment="Right"
                                  Margin="0,0,25,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="6*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!--Name-->
                                <userControls:UCLabelTextBox
                                    x:Name="client_name"
                                    Grid.Row="0"
                                    label="Nom*">
                                </userControls:UCLabelTextBox>

                                <!--Email-->
                                <userControls:UCLabelTextBox
                                    x:Name="client_email"
                                    Grid.Row="1"
                                    label="Email">
                                </userControls:UCLabelTextBox>

                                <!--ID-->
                                <userControls:UCLabelTextBox
                                    x:Name="client_id"
                                    Grid.Row="2"
                                    label="ID">
                                </userControls:UCLabelTextBox>
                            </Grid>

                            <!--Right Grid-->
                            <Grid Grid.Column="1" Grid.Row="1" 
                                  HorizontalAlignment="Left"
                                  Margin="25,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="6*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!--Address-->
                                <userControls:UCLabelTextBox
                                    x:Name="client_address"
                                    Grid.Row="0"
                                    label="Adresse">
                                </userControls:UCLabelTextBox>

                                <!--City-->
                                <userControls:UCLabelTextBox
                                    x:Name="client_city"
                                    Grid.Row="1"
                                    label="Ville">
                                </userControls:UCLabelTextBox>

                                <!--Phone-->
                                <userControls:UCLabelTextBox
                                    x:Name="client_phone"
                                    Grid.Row="2"
                                    label="N° Téléphone">
                                </userControls:UCLabelTextBox>
                            </Grid>
                        </Grid>

                        <!--Abort Save Buttons-->
                        <userControls:UCAbortSaveButtons
                            Grid.Column="0" Grid.Row="2"
                            LeftButtonCommand="{Binding m_abort_command}"
                            RightButtonCommand="{Binding m_save_command}">

                        </userControls:UCAbortSaveButtons>
                        
                    </Grid>
                </Grid>
                <!--Content-->
            </Grid>
            <!--Body-->

            <!--Footer-->
            <userControls:UCFooter 
                x:Name="footer" 
                Grid.Row="2">

            </userControls:UCFooter>
            <!--Footer-->
        </Grid>
        <!--Page-->
    </Grid>
</Page>
