<Page x:Class="Mams.views.pages.SaveClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mams.views.pages"
      xmlns:userControls="clr-namespace:Mams.views.userControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SaveClientsPage">

    <Grid>
        <!--Page is 12* per 12*-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MaxHeight="100"/>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*" MaxHeight="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*"/>
            </Grid.ColumnDefinitions>

            <!--Header-->
            <userControls:UCHeader x:Name="header" Grid.Row="0">

            </userControls:UCHeader>
            <!--Header-->

            <!--Body-->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="200"/>
                    <!--For menu-->
                    <ColumnDefinition Width="10*"/>
                    <!--For content-->
                </Grid.ColumnDefinitions>

                <!--Menu-->
                <userControls:UCMenu x:Name="pages_menu">

                </userControls:UCMenu>
                <!--Menu-->

                <!--Content-->
                <Grid Grid.Column="1" Background="#FFE0A5A5" Margin="3,3,10,3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" Background="#FFE0A5A5" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="9*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!--Left Grid-->
                        <Grid Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="6*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!--Name-->
                            <userControls:UCLabelTextBox
                            x:Name="client_name"
                            Grid.Row="0">
                            </userControls:UCLabelTextBox>

                            <!--Email-->
                            <userControls:UCLabelTextBox
                            x:Name="client_email"
                            Grid.Row="1">
                            </userControls:UCLabelTextBox>

                            <!--ID-->
                            <userControls:UCLabelTextBox
                            x:Name="client_id"
                            Grid.Row="2">
                            </userControls:UCLabelTextBox>
                        </Grid>

                        <!--Right Grid-->
                        <Grid Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="6*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!--Address-->
                            <userControls:UCLabelTextBox
                            x:Name="client_address"
                            Grid.Column="2" Grid.Row="1">
                            </userControls:UCLabelTextBox>

                            <!--City-->
                            <userControls:UCLabelTextBox
                            x:Name="client_city"
                            Grid.Column="2" Grid.Row="2">
                            </userControls:UCLabelTextBox>

                            <!--Phone-->
                            <userControls:UCLabelTextBox
                            x:Name="client_phone"
                            Grid.Column="2" Grid.Row="3">
                            </userControls:UCLabelTextBox>
                        </Grid>




                        <!--Save Button-->
                        <Button x:Name="save_client_btn" 
                                Content="Enregistrer" 
                                Grid.Column="2" Grid.Row="5" 
                                Height="30" Width="100"
                                HorizontalAlignment="Right"
                                FontSize="16">
                            
                        </Button>

                        <!--Return Button-->
                        <Button x:Name="return_client_btn" 
                                Content="Retour" 
                                Grid.Column="0" Grid.Row="5" 
                                Height="30" Width="100"
                                HorizontalAlignment="Left"
                                FontSize="16">

                        </Button>
                    </Grid>
                </Grid>
                <!--Content-->
            </Grid>
            <!--Body-->

            <!--Footer-->
            <userControls:UCFooter x:Name="footer" Grid.Row="2">

            </userControls:UCFooter>
            <!--Footer-->
        </Grid>
        <!--Page-->
    </Grid>
</Page>
