<UserControl x:Class="Mams.views.userControls.UCHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams.views.userControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
            <!--Header-->
            <Grid x:Name="header_grid" Grid.Row="0" Background="Gray">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label x:Name="title_page_lbl" Content="Page Title" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!--Header Menu-->
                <Grid x:Name="header_menu_grid" Grid.Row="1" Background="#FFE25F5F">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!--Home Menu-->
                    <Grid x:Name="home_menu_grid" Grid.Row="0" Background="#FFE25F5F">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="home_menu_btn" Content="Home" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MinHeight="40" MinWidth="40"/>
                    </Grid>

                    <!--Searchbar-->
                    <Grid x:Name="searchbar_grid" Grid.Column="1" Background="#FFE25F5F" MaxWidth="500">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="searchbar_cmbBox" Grid.Column="0" Margin="50,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="searchbar_txtBox" Grid.Column="1" Margin="1,0,50,0" VerticalAlignment="Center"/>
                        <ListView x:Name="searchbar_listView" Grid.Column="1" Margin="1,35,50,0" Height="150" VerticalAlignment="Top" Visibility="Hidden"/>
                    </Grid>
                    <!--Searchbar-->
                </Grid>
                <!--Header Menu-->
            </Grid>
            <!--Header-->
</UserControl>
