<UserControl x:Class="Mams.views.userControls.UCAbortSaveButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams.views.userControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="root">
    <Grid>
        <!--Save Button-->
        <Button x:Name="save_btn" 
            Content="{Binding label_right_button, ElementName=root}" 
            Grid.Column="2" Grid.Row="5" 
            Height="30" Width="120"
            HorizontalAlignment="Right"
            Margin="0,0,50,0"
            FontSize="16">

        </Button>

        <!--Return Button-->
        <Button x:Name="abort_btn" 
            Content="{Binding label_left_button, ElementName=root}" 
            Grid.Column="0" Grid.Row="5" 
            Height="30" Width="120"
            HorizontalAlignment="Left"
            Margin="50,0,0,0"
            FontSize="16">
        </Button>

    </Grid>
</UserControl>
