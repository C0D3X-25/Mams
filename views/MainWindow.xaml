<Window x:Class="Mams.views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mams.views"
        xmlns:userControls="clr-namespace:Mams.views.userControls"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="600" Width="1000" 
        MinHeight="600" MinWidth="1000">
    <Grid>
        <!--Page is 12* per 12*-->
        <Grid x:Name="page_grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MaxHeight="100"/>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*" MaxHeight="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*"/>
            </Grid.ColumnDefinitions>

            <!--Header-->
            <Grid x:Name="header_grid" Grid.Row="0" Background="Gray">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label x:Name="title_page_lbl" Content="Page Title" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!--Header Menu-->
                <Grid x:Name="header_menu_grid" Grid.Row="1" Background="#FFE25F5F">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!--Home Menu-->
                    <Grid x:Name="home_menu_grid" Grid.Row="0" Background="#FFE25F5F">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="home_menu_btn" Content="Home" Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MinHeight="40" MinWidth="40"/>
                    </Grid>
                    
                    <!--Searchbar-->
                    <userControls:UCHeaderSearchBar x:Name="header_searchBar" Grid.Column="1">
                        
                    </userControls:UCHeaderSearchBar>
                    <!--Searchbar-->

                </Grid>
                <!--Header Menu-->
            </Grid>
            <!--Header-->


            <!--Body-->
            <Grid x:Name="body_grid" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="200"/> <!--For menu-->
                    <ColumnDefinition Width="10*"/> <!--For content-->                    
                </Grid.ColumnDefinitions>

                <!--Menu-->
                <userControls:UCMenu x:Name="pages_menu">
                    
                </userControls:UCMenu>
                <!--Menu-->

                <!--Content-->
                <Grid x:Name="content_grid" Grid.Column="1" Background="#FFE0A5A5" Margin="3,3,10,3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label x:Name="content_label" Content="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <!--Content-->
            </Grid>
            <!--Body-->

            <!--Footer-->
            <userControls:UCFooter x:Name="footer" Grid.Row="2">
                
            </userControls:UCFooter>
            <!--Footer-->
        </Grid>
        <!--Page-->
    </Grid>
    <!--Grid-->
</Window>
