<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>ressources\app_icon.ico</ApplicationIcon>
    
    <!-- ClickOnce Application Settings -->
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.*</ApplicationVersion>
    <Product>Mams</Product>
    <PublisherName>ThJo</PublisherName>
  </PropertyGroup>

  <!-- ClickOnce Publish Settings (only apply during publish) -->
  <PropertyGroup Condition="'$(PublishProtocol)' == 'ClickOnce'">
    <PublishDir>publish\</PublishDir>
    <InstallMode>SelfContained</InstallMode>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <Install>true</Install>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".github\**" />
    <EmbeddedResource Remove=".github\**" />
    <None Remove=".github\**" />
    <Page Remove=".github\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ressources\app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="doc\MLD.simp.user" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlBackup.NET.MySqlConnector" Version="2.6.5" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="src\beehives\ListBeehivePage.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="src\beehives\SaveBeehivePage.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="src\productsTypes\ListProductTypePage.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="src\productsTypes\SaveProductTypePage.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="src\localizations\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ressources\invoice_pdf_logo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ressources\app_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
