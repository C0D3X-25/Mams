<Window x:Class="Mams_App.src.views.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
    Title="Mams"
    Width="{x:Static globalView:SGlobalView.LAUNCHER_WINDOW_WIDTH}"
    Height="{x:Static globalView:SGlobalView.LAUNCHER_WINDOW_HEIGHT}"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
<Border Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}" 
        CornerRadius="10" 
        BorderBrush="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}" 
        BorderThickness="2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="30,30,30,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Application Title -->
            <TextBlock Grid.Row="0"
                       Text="Mams"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Status Text -->
            <TextBlock Grid.Row="1"
                       x:Name="StatusText"
                       Text="Initializing..."
                       FontSize="14"
                       Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="380"/>

            <!-- Action Buttons Panel (hidden by default) -->
            <StackPanel Grid.Row="2"
                        x:Name="ActionButtonsPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0"
                        Visibility="Collapsed">
                <Button x:Name="YesButton"
                        Content="Yes"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_1}"
                        Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="YesButton_Click"/>
                <Button x:Name="NoButton"
                        Content="No"
                        Width="100"
                        Height="32"
                        Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_2}"
                        Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="NoButton_Click"/>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="3"
                         x:Name="ProgressBar"
                         Height="6"
                         IsIndeterminate="True"
                         Margin="0,15,0,10"
                         Background="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}"
                         Foreground="{x:Static globalView:SGlobalView.HEADER_TOP_COLOR}"/>

            <!-- Version Text -->
            <TextBlock Grid.Row="4"
                       x:Name="VersionText"
                       Text=""
                       FontSize="10"
                       Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                       HorizontalAlignment="Center"/>
        </Grid>
        
        <!-- Bottom Buttons Panel -->
        <Grid Grid.Row="1" Margin="30,0,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Checkbox above Start App Button -->
            <CheckBox x:Name="StartWhenReadyCheckBox"
                      Grid.Row="0"
                      Grid.Column="1"
                      Content="Start when ready"
                      IsChecked="False"
                      Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Right"/>
            
            <!-- Close App Button (Left) -->
            <Button x:Name="CloseAppButton"
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="Close App"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Left"
                    Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_2}"
                    Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="CloseAppButton_Click"/>
            
            <!-- Start App Button (Right) -->
            <Button x:Name="StartAppButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Content="Start App"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Right"
                    Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_1}"
                    Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    IsEnabled="False"
                    Click="StartAppButton_Click"/>
        </Grid>
    </Grid>
</Border>
</Window>
