<UserControl x:Class="Mams_App.src.views.UserControls.UCHeader"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:local="clr-namespace:Mams_App.src.views.UserControls"
xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
mc:Ignorable="d" 
d:DesignHeight="{x:Static globalView:SGlobalView.UC_HEADER_DESIGN_HEIGHT}" 
d:DesignWidth="{x:Static globalView:SGlobalView.UC_HEADER_DESIGN_WIDTH}"
x:Name="root">

    <!--Header-->
    <Grid Background="{x:Static globalView:SGlobalView.HEADER_TOP_COLOR}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Home Button-->
        <Button 
            Grid.Column="0" 
            Margin="10,5,10,5" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Left" 
            MinHeight="40" MinWidth="40"
            Background="{x:Static globalView:SGlobalView.HEADER_BUTTON_BACKGROUND_COLOR}"
            Command="{Binding m_navigate_homepage_command}"
            ToolTip="Home">
            <Path 
                Data="M10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 L12,3 L2,12 L5,12 L5,20 Z" 
                Fill="{x:Static globalView:SGlobalView.HEADER_BUTTON_TEXT_COLOR}"
                Stretch="Uniform"
                Width="20" Height="20"/>
        </Button>

        <!--Search Button-->
        <Button 
            Grid.Column="0" 
            Margin="60,5,10,5" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Left" 
            MinHeight="40" MinWidth="40"
            Background="{x:Static globalView:SGlobalView.HEADER_BUTTON_BACKGROUND_COLOR}"
            Command="{Binding m_navigate_searchpage_command}"
            ToolTip="{loc:Translate Search.Tooltip}">
            <Path 
                Data="M15.5,14 L14.71,14 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 L14,15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z" 
                Fill="{x:Static globalView:SGlobalView.HEADER_BUTTON_TEXT_COLOR}"
                Stretch="Uniform"
                Width="20" Height="20"/>
        </Button>

        <!--Title-->
        <Label
            Grid.Column="1"
            Content="{Binding title, ElementName=root}" 
            FontSize="25" FontWeight="Bold"
            HorizontalAlignment="Center" VerticalAlignment="Center" 
            Foreground="{x:Static globalView:SGlobalView.HEADER_TITLE_COLOR}">
        </Label>
    </Grid>
</UserControl>
