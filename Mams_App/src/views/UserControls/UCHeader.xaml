<UserControl x:Class="Mams_App.src.views.UserControls.UCHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams_App.src.views.UserControls"
             xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
             mc:Ignorable="d" 
             d:DesignHeight="{x:Static globalView:SGlobalView.UC_HEADER_DESIGN_HEIGHT}" 
             d:DesignWidth="{x:Static globalView:SGlobalView.UC_HEADER_DESIGN_WIDTH}"
             x:Name="root">

    <!--Header-->
    <Grid Background="{x:Static globalView:SGlobalView.HEADER_TOP_COLOR}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Home Button-->
        <Button 
            Content="Home" 
            Grid.Column="0" 
            Margin="10,5,10,5" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Left" 
            MinHeight="40" MinWidth="40"
            FontSize="12" FontWeight="Bold"
            Background="{x:Static globalView:SGlobalView.HEADER_BUTTON_BACKGROUND_COLOR}"
            Foreground="{x:Static globalView:SGlobalView.HEADER_BUTTON_TEXT_COLOR}"
            Command="{Binding m_navigate_homepage_command}">
        </Button>

        <!--Title-->
        <Label
            Grid.Column="1"
            Content="{Binding title, ElementName=root}" 
            FontSize="25" FontWeight="Bold"
            HorizontalAlignment="Center" VerticalAlignment="Center" 
            Foreground="{x:Static globalView:SGlobalView.HEADER_TITLE_COLOR}">
        </Label>
    </Grid>
</UserControl>
