<UserControl x:Class="Mams_App.src.views.UserControls.UCHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams_App.src.views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="1224"
             x:Name="root">

    <!--Header-->
    <Grid Background="{Binding m_page_top_color}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Home Button-->
        <Button 
            Content="Home" 
            Grid.Column="0" 
            Margin="10,5,10,5" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Left" 
            MinHeight="40" MinWidth="40"
            FontSize="12" FontWeight="Bold"
            Background="{Binding m_button_background_color}"
            Foreground="{Binding m_button_text_color}"
            Command="{Binding m_navigate_homepage_command}">
        </Button>

        <!--Title-->
        <Label
            Grid.Column="1"
            Content="{Binding title, ElementName=root}" 
            FontSize="25" FontWeight="Bold"
            HorizontalAlignment="Center" VerticalAlignment="Center" 
            Foreground="{Binding m_page_title_color}">
        </Label>
    </Grid>
</UserControl>
