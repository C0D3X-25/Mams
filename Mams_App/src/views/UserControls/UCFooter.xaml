<UserControl x:Class="Mams_App.src.views.UserControls.UCFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams_App.src.views.UserControls"
             xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
             mc:Ignorable="d" 
             d:DesignHeight="{x:Static globalView:SGlobalView.UC_FOOTER_DESIGN_HEIGHT}" 
             d:DesignWidth="{x:Static globalView:SGlobalView.UC_FOOTER_DESIGN_WIDTH}"
             x:Name="root">
    <!--Footer-->
    <Grid 
          Grid.Row="3" 
          Background="{x:Static globalView:SGlobalView.FOOTER_BACKGROUND_COLOR}">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- Version display on the right -->
        <TextBlock Grid.Column="1" 
                   Text="{Binding m_version}" 
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Right"
                   Margin="0,0,15,0"
                   Foreground="#888888"
                   FontSize="12"/>
    </Grid>
</UserControl>
