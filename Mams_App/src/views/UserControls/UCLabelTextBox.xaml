<UserControl x:Class="Mams_App.src.views.UserControls.UCLabelTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams_App.src.views.UserControls"
             xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
             mc:Ignorable="d" 
             d:DesignHeight="{x:Static globalView:SGlobalViewSize.UC_LABEL_TEXTBOX_DESIGN_HEIGHT}" 
             d:DesignWidth="{x:Static globalView:SGlobalViewSize.UC_LABEL_TEXTBOX_DESIGN_WIDTH}"
             x:Name="root">
    
    <!--Label + TextBox-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Label 
            x:Name="labelTextBox_lbl" 
            Grid.Column="0" Grid.Row="0" 
            Content="{Binding label, ElementName=root}" 
            FontSize="16" 
            VerticalAlignment="Center" HorizontalAlignment="Right">
            
        </Label>
        <TextBox 
            x:Name="labelTextBox_txtBox" 
            Text="{Binding text, ElementName=root, UpdateSourceTrigger=PropertyChanged}"
            IsEnabled="{Binding isEnabled, ElementName=root}"
            Grid.Column="1" Grid.Row="0" 
            TextWrapping="NoWrap"
            Margin="5,0,5,0" 
            FontSize="16" 
            VerticalAlignment="Center"
            MinHeight="25" MinWidth="200"
            Width="200"
            MaxWidth="200"
            HorizontalScrollBarVisibility="Auto">
        </TextBox>
    </Grid>
</UserControl>
