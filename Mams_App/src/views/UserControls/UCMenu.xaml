<UserControl x:Class="Mams.src.views.UserControls.UCMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams.src.views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="200"
             x:Name="root">
    <!--Menu-->
    <Grid Grid.Column="0" 
          Background="{Binding m_background_color_1}" 
          Margin="10,3,3,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Menu Buttons-->
        <Grid Grid.Column="0" 
              Background="{Binding m_background_color_2}" 
              MinHeight="400" MaxHeight="600" 
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label 
                Content="Menu"
                Foreground="{Binding m_button_text_color}"
                FontSize="20" 
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button 
                Content="Profits" 
                Grid.Row="1" 
                FontSize="16" 
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_profit_command}"/>
            <Button 
                Content="Frais" 
                Grid.Row="2" 
                FontSize="16" 
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_fee_command}"/>
            <Button 
                Content="Contacts"
                Grid.Row="3"
                FontSize="16"
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_entity_command}"/>
            <Button 
                Content="Produits" 
                Grid.Row="4" 
                FontSize="16" 
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_product_command}"/>
            <Button 
                Content="Lots"
                Grid.Row="5"
                FontSize="16" 
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_lot_command}"/>
            <Button 
                Content="Ruchers"
                Grid.Row="6"
                FontSize="16" 
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_beehive_command}"/>
            <Button 
                Content="Catégories de Produit"
                Grid.Row="7"
                FontSize="16" 
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_product_category_command}"/>
            <Button 
                Content="Types de Produit"
                Grid.Row="8"
                FontSize="16" 
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_product_type_command}"/>
            <Button 
                Content="Formes de Produit"
                Grid.Row="9"
                FontSize="16" 
                Margin="3"
                Background="{Binding m_button_color}"
                Foreground="{Binding m_button_text_color}"
                Command="{Binding m_navigate_list_product_shape_command}"/>
        </Grid>
        <!--Menu Buttons-->
    </Grid>
    <!--Menu-->
</UserControl>
