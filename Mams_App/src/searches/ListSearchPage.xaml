<Page x:Class="Mams_App.src.searches.ListSearchPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:local="clr-namespace:Mams_App.src.searches"
xmlns:userControls="clr-namespace:Mams_App.src.views.UserControls"
xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
xmlns:converters="clr-namespace:Mams_App.src.converters"
xmlns:helpers="clr-namespace:Mams_App.src.helpers"
xmlns:commands="clr-namespace:Mams_App.src.commands"
mc:Ignorable="d" 
d:DesignHeight="{x:Static globalView:SGlobalView.PAGE_DESIGN_HEIGHT}" 
d:DesignWidth="{x:Static globalView:SGlobalView.PAGE_DESIGN_WIDTH}"
Title="ListSearchPage">

    <Page.Resources>
        <converters:SortArrowConverter x:Key="SortArrowConverter"/>
        <converters:ItemTypeToLocalizedStringConverter x:Key="ItemTypeToLocalizedStringConverter"/>
    </Page.Resources>

    <Grid Background="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MaxHeight="50"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="1*" MaxHeight="25"/>
        </Grid.RowDefinitions>

        <!--Header-->
        <userControls:UCHeader 
            Grid.Row="0"
            title="{loc:Translate Page.Search}">
        </userControls:UCHeader>

        <!--Body-->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="200"/>
                <!--For menu-->
                <ColumnDefinition Width="10*"/>
                <!--For content-->
            </Grid.ColumnDefinitions>

            <!--Menu-->
            <userControls:UCMenu>
            </userControls:UCMenu>

            <!--Content-->
            <Grid 
                Grid.Column="1" 
                Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}" 
                Margin="3,3,10,3">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!--Search Input Area-->
                    <Grid Grid.Row="0" Margin="50,10,50,10">
                        <TextBox 
                            Text="{Binding m_search_text, UpdateSourceTrigger=PropertyChanged}"
                            Height="35"
                            FontSize="16"
                            VerticalContentAlignment="Center"
                            Padding="10,0,10,0"
                            helpers:AutoFocusBehavior.AutoFocus="True"/>
                    </Grid>

                    <!--List of Search Results-->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="10*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <ListView 
                            Grid.Column="1" 
                            Margin="0,0,0,10"
                            MinWidth="500"
                            FontSize="14"
                            ItemsSource="{Binding m_list_items}"
                            SelectedItem="{Binding m_selected_item}"
                            commands:MouseCommand.MouseDoubleClickCommand="{Binding m_double_click_command}">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Command" Value="{Binding DataContext.m_sort_command, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}, Path=Column}"/>
                                </Style>
                                
                                <DataTemplate x:Key="HeaderTemplateWithArrow">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}"/>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                    <Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="Column.DisplayMemberBinding.Path.Path"/>
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_sorted_column"/>
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_sort_direction"/>
                                                    <Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="Column.(helpers:SortPathAttached.SortPath)"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{loc:Translate Column.ItemType}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding item_type, Converter={StaticResource ItemTypeToLocalizedStringConverter}}" Width="120"/>
                                    <GridViewColumn Header="{loc:Translate Column.ItemName}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" Width="200" helpers:SortPathAttached.SortPath="item_name">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock 
                                                    helpers:HighlightTextBehavior.Text="{Binding item_name}"
                                                    helpers:HighlightTextBehavior.HighlightText="{Binding DataContext.m_search_text, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Translate Column.ItemCustomId}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" Width="120" helpers:SortPathAttached.SortPath="item_custom_id">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock 
                                                    helpers:HighlightTextBehavior.Text="{Binding item_custom_id}"
                                                    helpers:HighlightTextBehavior.HighlightText="{Binding DataContext.m_search_text, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Translate Column.ItemDate}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" Width="100" helpers:SortPathAttached.SortPath="item_date">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock 
                                                    helpers:HighlightTextBehavior.Text="{Binding item_date}"
                                                    helpers:HighlightTextBehavior.HighlightText="{Binding DataContext.m_search_text, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Translate Column.ItemDetails}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" Width="200" helpers:SortPathAttached.SortPath="item_details">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock 
                                                    helpers:HighlightTextBehavior.Text="{Binding item_details}"
                                                    helpers:HighlightTextBehavior.HighlightText="{Binding DataContext.m_search_text, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <!--Results Count-->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="50,5,0,10">
                        <TextBlock 
                            Text="{loc:Translate Label.ResultsCount}" 
                            FontSize="14" 
                            VerticalAlignment="Center"/>
                        <TextBlock 
                            Text="{Binding m_results_count}" 
                            FontSize="14" 
                            FontWeight="Bold"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <!--Content-->
        </Grid>

        <!--Footer-->
        <userControls:UCFooter
            Grid.Row="2">
        </userControls:UCFooter>
    </Grid>
</Page>
