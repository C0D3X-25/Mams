<Window x:Class="Mams_App.src.mainWindow.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:Mams_App.src.mainWindow"
xmlns:userControls="clr-namespace:Mams_App.src.mainWindow.UserControls"
xmlns:globalView="clr-namespace:Mams_App.src.globals"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
mc:Ignorable="d"
Title="{loc:Translate App.Title}" 
Height="{x:Static globalView:SGlobalView.MAIN_WINDOW_HEIGHT}" 
Width="{x:Static globalView:SGlobalView.MAIN_WINDOW_WIDTH}" 
MinHeight="{x:Static globalView:SGlobalView.MAIN_WINDOW_MIN_HEIGHT}" 
MinWidth="{x:Static globalView:SGlobalView.MAIN_WINDOW_MIN_WIDTH}"
PreviewMouseDown="Window_PreviewMouseDown">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{loc:Translate Menu.File}">
                <MenuItem Header="{loc:Translate Menu.Settings}" Click="MenuItem_Settings_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Translate Menu.Exit}" Click="MenuItem_Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Translate Menu.Help}">
                <MenuItem Header="{loc:Translate Menu.About}" Click="MenuItem_About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>
    </DockPanel>
</Window>
