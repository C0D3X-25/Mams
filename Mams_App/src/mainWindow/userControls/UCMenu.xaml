<UserControl x:Class="Mams_App.src.mainWindow.userControls.UCMenu"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:local="clr-namespace:Mams_App.src.mainWindow.userControls"
xmlns:globalView="clr-namespace:Mams_App.src.globals"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
mc:Ignorable="d" 
d:DesignHeight="{x:Static globalView:SGlobalView.UC_MENU_DESIGN_HEIGHT}" 
d:DesignWidth="{x:Static globalView:SGlobalView.UC_MENU_DESIGN_WIDTH}"
x:Name="root">
    <!--Menu-->
    <Grid Grid.Column="0" 
          Background="{x:Static globalView:SGlobalView.MENU_BACKGROUND_COLOR}" 
          Margin="10,3,3,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--Menu Buttons-->
        <Grid Grid.Column="0" 
              Background="{x:Static globalView:SGlobalView.MENU_BACKGROUND_COLOR}" 
              MinHeight="400" MaxHeight="600" 
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label 
            Content="{loc:Translate Nav.Title}"
            Foreground="{x:Static globalView:SGlobalView.MENU_BUTTON_TEXT_COLOR}"
            FontSize="20" 
            HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.Profits}" 
            Grid.Row="1" 
            Command="{Binding m_navigate_list_profit_command}"
            IsCurrentPage="{Binding m_is_profit_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.Fees}" 
            Grid.Row="2" 
            Command="{Binding m_navigate_list_fee_command}"
            IsCurrentPage="{Binding m_is_fee_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.Contacts}"
            Grid.Row="3"
            Command="{Binding m_navigate_list_entity_command}"
            IsCurrentPage="{Binding m_is_entity_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.Products}" 
            Grid.Row="4" 
            Command="{Binding m_navigate_list_product_command}"
            IsCurrentPage="{Binding m_is_product_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.Lots}"
            Grid.Row="5"
            Command="{Binding m_navigate_list_lot_command}"
            IsCurrentPage="{Binding m_is_lot_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.Beehives}"
            Grid.Row="6"
            Command="{Binding m_navigate_list_beehive_command}"
            IsCurrentPage="{Binding m_is_beehive_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.Treatments}"
            Grid.Row="7"
            Command="{Binding m_navigate_list_treatment_command}"
            IsCurrentPage="{Binding m_is_treatment_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.TreatmentStocks}"
            Grid.Row="8"
            Command="{Binding m_navigate_list_treatment_stock_command}"
            IsCurrentPage="{Binding m_is_treatment_stock_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.ProductCategories}"
            Grid.Row="9"
            Command="{Binding m_navigate_list_product_category_command}"
            IsCurrentPage="{Binding m_is_product_category_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.ProductTypes}"
            Grid.Row="10"
            Command="{Binding m_navigate_list_product_type_command}"
            IsCurrentPage="{Binding m_is_product_type_page_active}"/>
            <local:UCPageNavigationMenuButton 
            Content="{loc:Translate Nav.ProductShapes}"
            Grid.Row="11"
            Command="{Binding m_navigate_list_product_shape_command}"
            IsCurrentPage="{Binding m_is_product_shape_page_active}"
            Visibility="Collapsed"/>
        </Grid>
        <!--Menu Buttons-->
    </Grid>
    <!--Menu-->
</UserControl>
