<UserControl x:Class="Mams_App.src.mainWindow.userControls.UCHeader"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:local="clr-namespace:Mams_App.src.mainWindow.userControls"
xmlns:globalView="clr-namespace:Mams_App.src.globals"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
mc:Ignorable="d" 
d:DesignHeight="{x:Static globalView:SGlobalView.UC_HEADER_DESIGN_HEIGHT}" 
d:DesignWidth="{x:Static globalView:SGlobalView.UC_HEADER_DESIGN_WIDTH}"
x:Name="root">

    <!--Header-->
    <Grid Background="{x:Static globalView:SGlobalView.HEADER_TOP_COLOR}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!--Left Buttons: Home and Search-->
        <StackPanel 
            Grid.Column="0" 
            Orientation="Horizontal" 
            VerticalAlignment="Center"
            Margin="10,5,10,5">
            
            <!--Home Button-->
            <local:UCHeaderNavigationButton
                Command="{Binding m_navigate_homepage_command}"
                IsCurrentPage="{Binding m_is_home_page_active}"
                ToolTip="Home"
                IconData="M10,20 L10,14 L14,14 L14,20 L19,20 L19,12 L22,12 L12,3 L2,12 L5,12 L5,20 Z"/>

            <!--Search Button-->
            <local:UCHeaderNavigationButton
                Command="{Binding m_navigate_searchpage_command}"
                IsCurrentPage="{Binding m_is_search_page_active}"
                ToolTip="{loc:Translate Search.Tooltip}"
                IconData="M15.5,14 L14.71,14 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 L14,15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z"/>
        </StackPanel>

        <!--Title-->
        <Label
            Grid.Column="1"
            Content="{Binding title, ElementName=root}" 
            FontSize="25" FontWeight="Bold"
            HorizontalAlignment="Center" VerticalAlignment="Center" 
            Foreground="{x:Static globalView:SGlobalView.HEADER_TITLE_COLOR}"/>

        <!--Right Button: Settings-->
        <StackPanel 
            Grid.Column="2" 
            Orientation="Horizontal" 
            VerticalAlignment="Center"
            Margin="10,5,10,5">
            
            <!--Settings Button-->
            <Button 
                MinHeight="40" MinWidth="40"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding m_open_settings_command}"
                ToolTip="{loc:Translate Menu.Settings}">
                <Path 
                    Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" 
                    Fill="{x:Static globalView:SGlobalView.HEADER_BUTTON_TEXT_COLOR}"
                    Stretch="Uniform"
                    Width="20" Height="20"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
