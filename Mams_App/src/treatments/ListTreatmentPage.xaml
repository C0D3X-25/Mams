<Page x:Class="Mams_App.src.treatments.ListTreatmentPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:local="clr-namespace:Mams_App.src.treatments"
xmlns:userControls="clr-namespace:Mams_App.src.mainWindow.userControls"
xmlns:commands="clr-namespace:Mams_App.src.commands"
xmlns:globalView="clr-namespace:Mams_App.src.globals"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
xmlns:converters="clr-namespace:Mams_App.src.converters"
xmlns:helpers="clr-namespace:Mams_App.src.helpers"
mc:Ignorable="d" 
d:DesignHeight="{x:Static globalView:SGlobalView.PAGE_DESIGN_HEIGHT}" 
d:DesignWidth="{x:Static globalView:SGlobalView.PAGE_DESIGN_WIDTH}"
Title="ListTreatmentPage">

    <Page.Resources>
        <converters:SortArrowConverter x:Key="SortArrowConverter"/>
    </Page.Resources>

    <Grid Background="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MaxHeight="50"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="1*" MaxHeight="25"/>
        </Grid.RowDefinitions>

        <!--Header-->
        <userControls:UCHeader 
            Grid.Row="0"
            title="{loc:Translate Page.ListTreatments}"/>

        <!--Body-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="200"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <!--Menu-->
            <userControls:UCMenu/>

            <!--Content-->
            <Grid 
                Grid.Column="1" 
                Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}" 
                Margin="3,3,10,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!--Search Bar-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                       Content="{loc:Translate Resume.SearchBy}"
                       FontSize="16" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Right"/>

                    <!--Search in table-->
                    <ComboBox Grid.Column="1"
                       Margin="5,0,5,0" 
                       FontSize="16" 
                       VerticalAlignment="Center"
                       ItemsSource="{Binding m_list_table}"
                       SelectedItem="{Binding m_selected_table}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding m_name_to_display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--Search by -->
                    <ComboBox Grid.Column="2"
                       Margin="5,0,5,0" 
                       FontSize="16" 
                       VerticalAlignment="Center"
                       IsEnabled="{Binding m_is_filter_item_enabled}"
                       ItemsSource="{Binding m_list_filter_item}"
                       SelectedItem="{Binding m_selected_filter_item}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding filter_item_to_display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label Grid.Column="3"
                       Content="{loc:Translate Resume.ForYear}"
                       FontSize="16" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>

                    <!--Search by year-->
                    <ComboBox Grid.Column="4"
                       Margin="5,0,5,0" 
                       FontSize="16" 
                       VerticalAlignment="Center"
                       ItemsSource="{Binding m_list_year}"
                       SelectedItem="{Binding m_selected_year}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding filter_year}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--Clear Search Button-->
                    <Button Grid.Column="5"
                       Margin="5,0,5,0" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Width="25" Height="25"
                       Content="X"
                       Command="{Binding m_clear_search_command}"
                       Style="{StaticResource SecondaryIconButtonStyle}"/>
                </Grid>

                <!--List of Treatments-->
                <Grid Grid.Row="1" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <ListView 
                        Grid.Column="1" 
                        Margin="0,0,0,10"
                        MinWidth="500"
                        FontSize="14"
                        ItemsSource="{Binding m_list_items}"
                        SelectedItem="{Binding m_selected_item}"
                        commands:MouseCommand.MouseDoubleClickCommand="{Binding m_double_click_command}">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Command" Value="{Binding DataContext.m_sort_command, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}, Path=Column}"/>
                            </Style>
                            
                            <DataTemplate x:Key="HeaderTemplateWithArrow">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}"/>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="Column.DisplayMemberBinding.Path.Path"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_sorted_column"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_sort_direction"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="Column.(helpers:SortPathAttached.SortPath)"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Translate Column.Date}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_date}"/>
                                <GridViewColumn Header="{loc:Translate Column.Beehive}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding beehive_name}"/>
                                <GridViewColumn Header="{loc:Translate Column.Number}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding beehive_number}"/>
                                <GridViewColumn Header="{loc:Translate Column.Region}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding region_name}"/>
                                <GridViewColumn Header="{loc:Translate Column.HiveCount}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_hive_count}"/>
                                <GridViewColumn Header="{loc:Translate Column.Product}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding product_name}"/>
                                <GridViewColumn Header="{loc:Translate Column.DosePerHive}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_dose_per_hive}"/>
                                <GridViewColumn Header="{loc:Translate Column.DoseTotal}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_dose_total}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!--Bottom Buttons-->
                <Grid Grid.Row="2">
                    <!--PDF and Delete Buttons (Left)-->
                    <StackPanel 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Margin="50,0,0,0">
                        <Button 
                            Content="PDF"
                            Command="{Binding m_generate_pdf_command}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button 
                            Content="{Binding m_delete_button_text}"
                            Command="{Binding m_delete_command}"
                            Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>

                    <!--Edit and Add Buttons (Right)-->
                    <StackPanel 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Margin="0,0,50,0">
                        <Button 
                            Content="{loc:Translate Common.Edit}"
                            Command="{Binding m_modify_command}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button 
                            Content="{loc:Translate Button.NewTreatment}"
                            Command="{Binding m_add_command}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!--Footer-->
        <userControls:UCFooter Grid.Row="2"/>
    </Grid>
</Page>
