<Page x:Class="Mams_App.src.treatments.SaveTreatmentPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:local="clr-namespace:Mams_App.src.treatments"
xmlns:userControls="clr-namespace:Mams_App.src.mainWindow.userControls"
xmlns:globalView="clr-namespace:Mams_App.src.globals"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
mc:Ignorable="d" 
d:DesignHeight="{x:Static globalView:SGlobalView.PAGE_DESIGN_HEIGHT}" 
d:DesignWidth="{x:Static globalView:SGlobalView.PAGE_DESIGN_WIDTH}"
Title="SaveTreatmentPage">

    <Grid Background="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MaxHeight="50"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="1*" MaxHeight="25"/>
        </Grid.RowDefinitions>

        <!--Header-->
        <userControls:UCHeader 
            Grid.Row="0"
            title="{loc:Translate Treatment.Title}">
        </userControls:UCHeader>

        <!--Body-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="200"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <!--Menu-->
            <userControls:UCMenu/>

            <!--Content-->
            <Grid Grid.Column="1" Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}" Margin="3,3,10,3">

                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="9*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <!--Fields-->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!--Left Grid-->
                        <Grid Grid.Column="0" 
                              HorizontalAlignment="Right"
                              Margin="0,0,25,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="3*"/>
                            </Grid.RowDefinitions>

                            <!--Date-->
                            <userControls:UCLabelTextBox
                                Grid.Row="0"
                                label="{loc:Translate Form.Date}"
                                text="{Binding m_treatment.treatment_date, UpdateSourceTrigger=PropertyChanged}"/>

                            <!--Beehive-->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Label
                                    Grid.Column="0" 
                                    Content="{loc:Translate Form.Beehive}"
                                    FontSize="16" 
                                    VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                <ComboBox
                                    Grid.Column="1" 
                                    Margin="5,0,5,0" 
                                    FontSize="16" 
                                    VerticalAlignment="Center"
                                    MinHeight="25" MinWidth="200"
                                    ItemsSource="{Binding m_list_beehive, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding m_selected_beehive, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} - {1}">
                                                        <Binding Path="beehive_name"/>
                                                        <Binding Path="beehive_number"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!--Hive Count-->
                            <userControls:UCLabelTextBox
                                Grid.Row="2"
                                label="{loc:Translate Form.HiveCount}"
                                text="{Binding m_treatment_hive_count, UpdateSourceTrigger=PropertyChanged}"/>

                            <!--Product-->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Label
                                    Grid.Column="0" 
                                    Content="{loc:Translate Form.TreatmentProduct}"
                                    FontSize="16" 
                                    VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                <ComboBox
                                    Grid.Column="1" 
                                    Margin="5,0,5,0" 
                                    FontSize="16" 
                                    VerticalAlignment="Center"
                                    MinHeight="25" MinWidth="200"
                                    ItemsSource="{Binding m_list_product, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding m_selected_product, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding product_name, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!--Dose Per Hive-->
                            <userControls:UCLabelTextBox
                                Grid.Row="4"
                                label="{loc:Translate Form.DosePerHive}"
                                text="{Binding m_treatment_dose_per_hive, UpdateSourceTrigger=PropertyChanged}"/>

                            <!--Dose Total (read-only)-->
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Label
                                    Grid.Column="0" 
                                    Content="{loc:Translate Form.DoseTotal}"
                                    FontSize="16" 
                                    VerticalAlignment="Center" HorizontalAlignment="Right"/>

                                <Label
                                    Grid.Column="1"
                                    Content="{Binding m_treatment_dose_total_ui}"
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                    Margin="5,0,5,0"/>
                            </Grid>
                        </Grid>

                        <!--Right Grid-->
                        <Grid Grid.Column="1" 
                              HorizontalAlignment="Left"
                              Margin="25,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="7*"/>
                            </Grid.RowDefinitions>

                            <!--ID-->
                            <userControls:UCLabelTextBox
                                Grid.Row="0"
                                label="ID"
                                text="{Binding m_treatment.treatment_id, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="Hidden"
                                isEnabled="False"/>
                        </Grid>
                    </Grid>

                    <!--Abort Save Buttons-->
                    <Button 
                        Grid.Row="2"
                        Content="{loc:Translate Common.Save}"
                        Command="{Binding m_save_command}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,50,0"/>

                    <Button 
                        Grid.Row="2"
                        Content="{loc:Translate Common.Cancel}"
                        Command="{Binding m_abort_command}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="50,0,0,0"/>
                </Grid>
            </Grid>
        </Grid>

        <!--Footer-->
        <userControls:UCFooter Grid.Row="2"/>

    </Grid>
</Page>
