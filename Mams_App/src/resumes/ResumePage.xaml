<Page 
x:Class="Mams_App.src.resumes.ResumePage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:local="clr-namespace:Mams_App.src.resumes"
xmlns:userControls="clr-namespace:Mams_App.src.views.UserControls"
xmlns:commands="clr-namespace:Mams_App.src.commands"
xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
xmlns:converters="clr-namespace:Mams_App.src.converters"
mc:Ignorable="d" 
d:DesignHeight="{x:Static globalView:SGlobalView.PAGE_DESIGN_HEIGHT}" 
d:DesignWidth="{x:Static globalView:SGlobalView.PAGE_DESIGN_WIDTH}"
Title="ResumePage">

    <Page.Resources>
        <converters:SortArrowConverter x:Key="SortArrowConverter"/>
    </Page.Resources>

    <Grid Background="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MaxHeight="50"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="1*" MaxHeight="25"/>
        </Grid.RowDefinitions>

        <!--Header-->
        <userControls:UCHeader Grid.Row="0" title="{loc:Translate Resume.Title}"/>

        <!--Body-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="200"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <!--Menu-->
            <userControls:UCMenu/>

            <!--Content-->
            <Grid Grid.Column="1" 
                 Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}" 
                 Margin="3,3,10,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition Height="2*" MinHeight="175"/>
                </Grid.RowDefinitions>

                <!--Search Bar-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                       Content="{loc:Translate Resume.SearchBy}"
                       FontSize="16" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Right"/>

                    <!--Search in table-->
                    <ComboBox Grid.Column="1"
                       Margin="5,0,5,0" 
                       FontSize="16" 
                       VerticalAlignment="Center"
                       ItemsSource="{Binding m_list_table}"
                       SelectedItem="{Binding m_selected_table}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding m_name_to_display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--Search by -->
                    <ComboBox Grid.Column="2"
                       Margin="5,0,5,0" 
                       FontSize="16" 
                       VerticalAlignment="Center"
                       IsEnabled="{Binding m_is_search_item_enabled}"
                       ItemsSource="{Binding m_list_search_item}"
                       SelectedItem="{Binding m_selected_search_item}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding search_item_to_display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label Grid.Column="3"
                       Content="{loc:Translate Resume.ForYear}"
                       FontSize="16" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"/>

                    <!--Search by year-->
                    <ComboBox Grid.Column="4"
                       Margin="5,0,5,0" 
                       FontSize="16" 
                       VerticalAlignment="Center"
                       ItemsSource="{Binding m_list_year}"
                       SelectedItem="{Binding m_selected_year}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding search_year}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--Clear Search Button-->
                    <Button Grid.Column="5"
                       Margin="5,0,5,0" 
                       FontSize="16" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Width="25" Height="25"
                       MaxWidth="25" MaxHeight="25"
                       Content="X"
                       Command="{Binding m_clear_search_command}"
                       Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_1}"
                       Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"/>
                </Grid>

                <!--Resume Views-->
                <Grid Grid.Row="1" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                       Content="{loc:Translate Profit.Title}" 
                       FontSize="20"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>

                    <!--Profit-->
                    <ListView Grid.Column="0" Grid.Row="1"
                       FontSize="14"
                       Margin="0,0,5,0"
                       ItemsSource="{Binding m_list_profit_item}"
                       SelectedItem="{Binding m_selected_profit_item}"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.IsDeferredScrollingEnabled="True"
                       commands:MouseCommand.MouseDoubleClickCommand="{Binding m_double_click_command_profit}">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Command" Value="{Binding DataContext.m_sort_profit_command, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}, Path=Column.DisplayMemberBinding.Path.Path}"/>
                            </Style>
                            
                            <DataTemplate x:Key="ProfitHeaderTemplateWithArrow">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}"/>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="Column.DisplayMemberBinding.Path.Path"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_profit_sorted_column"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_profit_sort_direction"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Translate Common.Number}" HeaderTemplate="{StaticResource ProfitHeaderTemplateWithArrow}" DisplayMemberBinding="{Binding receipt.receipt_number}"/>
                                <GridViewColumn Header="{loc:Translate Common.Client}" HeaderTemplate="{StaticResource ProfitHeaderTemplateWithArrow}" DisplayMemberBinding="{Binding entity.entity_name}"/>
                                <GridViewColumn Header="{loc:Translate Common.Date}" HeaderTemplate="{StaticResource ProfitHeaderTemplateWithArrow}" DisplayMemberBinding="{Binding receipt.receipt_date_created}"/>
                                <GridViewColumn Header="{loc:Translate Common.TotalPrice}" HeaderTemplate="{StaticResource ProfitHeaderTemplateWithArrow}" DisplayMemberBinding="{Binding receipt.receipt_total_price}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Label Grid.Column="1"
                       Content="{loc:Translate Fee.Title}" 
                       FontSize="20"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>

                    <!--Fees-->
                    <ListView Grid.Column="1" Grid.Row="1"
                       FontSize="14"
                       Margin="5,0,0,0"
                       ItemsSource="{Binding m_list_fee_item}"
                       SelectedItem="{Binding m_selected_fee_item}"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.IsDeferredScrollingEnabled="True"
                       commands:MouseCommand.MouseDoubleClickCommand="{Binding m_double_click_command_fee}">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Command" Value="{Binding DataContext.m_sort_fee_command, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}, Path=Column.DisplayMemberBinding.Path.Path}"/>
                            </Style>
                            
                            <DataTemplate x:Key="FeeHeaderTemplateWithArrow">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}"/>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="Column.DisplayMemberBinding.Path.Path"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_fee_sorted_column"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_fee_sort_direction"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Translate Common.Number}" HeaderTemplate="{StaticResource FeeHeaderTemplateWithArrow}" DisplayMemberBinding="{Binding receipt.receipt_number}"/>
                                <GridViewColumn Header="{loc:Translate Common.Supplier}" HeaderTemplate="{StaticResource FeeHeaderTemplateWithArrow}" DisplayMemberBinding="{Binding entity.entity_name}"/>
                                <GridViewColumn Header="{loc:Translate Common.Date}" HeaderTemplate="{StaticResource FeeHeaderTemplateWithArrow}" DisplayMemberBinding="{Binding receipt.receipt_date_created}"/>
                                <GridViewColumn Header="{loc:Translate Common.TotalPrice}" HeaderTemplate="{StaticResource FeeHeaderTemplateWithArrow}" DisplayMemberBinding="{Binding receipt.receipt_total_price}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <Grid Grid.Row="2" Margin="5, 2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!--Profit Totals (Left Column)-->
                    <Grid Grid.Column="0" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!--Row 0: Include Free Items Toggle-->
                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,5,0"
                                  FontSize="16"
                                  IsChecked="{Binding m_include_free_items}"
                                  Content="{loc:Translate Resume.IncludeFreeItems}"/>

                        <!--Row 1: Poids Total-->
                        <Label Grid.Row="1" Grid.Column="1"
                           HorizontalContentAlignment="Right"
                           FontSize="16"
                           Content="{loc:Translate Resume.TotalWeightProfit}"/>
                        <Label Grid.Row="1" Grid.Column="2"
                           HorizontalContentAlignment="Left"
                           FontSize="16"
                           Content="{Binding m_total_weight_ui}"/>

                        <!--Row 2: Quantité Total-->
                        <Label Grid.Row="2" Grid.Column="1"
                           HorizontalContentAlignment="Right"
                           FontSize="16"
                           Content="{loc:Translate Resume.TotalQuantityProfit}"/>
                        <Label Grid.Row="2" Grid.Column="2"
                           HorizontalContentAlignment="Left"
                           FontSize="16"
                           Content="{Binding m_total_quantity_ui}"/>

                        <!--Row 3: Prix Moyen par Unité-->
                        <Label Grid.Row="3" Grid.Column="1"
                           HorizontalContentAlignment="Right"
                           FontSize="16"
                           Content="{loc:Translate Resume.AveragePricePerUnit}"/>
                        <Label Grid.Row="3" Grid.Column="2"
                           HorizontalContentAlignment="Left"
                           FontSize="16"
                           Content="{Binding m_average_price_per_unit_ui}"/>

                        <!--Row 4: Prix Moyen par kg-->
                        <Label Grid.Row="4" Grid.Column="1"
                           HorizontalContentAlignment="Right"
                           FontSize="16"
                           Content="{loc:Translate Resume.AveragePricePerKg}"/>
                        <Label Grid.Row="4" Grid.Column="2"
                           HorizontalContentAlignment="Left"
                           FontSize="16"
                           Content="{Binding m_average_price_per_weight_ui}"/>
                    </Grid>

                    <!--Fee Totals (Right Column)-->
                    <Grid Grid.Column="1" Margin="5,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!--Row 1: Total Profits-->
                        <Label Grid.Column="0" Grid.Row="1"
                           HorizontalContentAlignment="Right"
                           FontSize="16"
                           Content="{loc:Translate Resume.TotalProfits}"/>
                        <Label Grid.Column="1" Grid.Row="1"
                           HorizontalContentAlignment="Left"
                           FontSize="16"
                           Content="{Binding m_total_profit_ui}"/>

                        <!--Row 2: Total Frais-->
                        <Label Grid.Column="0" Grid.Row="2"
                           HorizontalContentAlignment="Right"
                           FontSize="16"
                           Content="{loc:Translate Resume.TotalFees}"/>
                        <Label Grid.Column="1" Grid.Row="2"
                           HorizontalContentAlignment="Left"
                           FontSize="16"
                           Foreground="{Binding m_total_fee_color}"
                           Content="{Binding m_total_fee_ui}"/>

                        <!--Row 3: Total-->
                        <Label Grid.Column="0" Grid.Row="3"
                           HorizontalContentAlignment="Right"
                           FontSize="16"
                           Content="{loc:Translate Resume.Total}"/>
                        <Label Grid.Column="1" Grid.Row="3"
                           HorizontalContentAlignment="Left"
                           FontSize="16"
                           Foreground="{Binding m_total_color}"
                           Content="{Binding m_total_ui}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!--Footer-->
        <userControls:UCFooter x:Name="footer" Grid.Row="2"/>
    </Grid>
</Page>
