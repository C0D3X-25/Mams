<Window x:Class="Mams_App.src.launcher.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
    Title="Mams"
    Width="{x:Static globalView:SGlobalView.LAUNCHER_WINDOW_WIDTH}"
    Height="{x:Static globalView:SGlobalView.LAUNCHER_WINDOW_HEIGHT}"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
<Border Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}" 
        CornerRadius="10" 
        BorderBrush="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}" 
        BorderThickness="2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="30,30,30,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Application Title -->
            <TextBlock Grid.Row="0"
                       Text="Mams"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Status Text -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusText}"
                       FontSize="14"
                       Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="380"/>

            <!-- Action Buttons Panel (hidden by default) -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,0"
                        Visibility="{Binding ActionButtonsVisibility}">
                <Button Content="{Binding YesButtonText}"
                        Command="{Binding YesCommand}"
                        Width="100"
                        Height="32"
                        Margin="0,0,10,0"
                        Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_1}"
                        Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="{Binding NoButtonText}"
                        Command="{Binding NoCommand}"
                        Width="100"
                        Height="32"
                        Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_2}"
                        Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="3"
                         Height="6"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Value="{Binding ProgressValue}"
                         Visibility="{Binding ProgressBarVisibility}"
                         Margin="0,15,0,10"
                         Background="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}"
                         Foreground="{x:Static globalView:SGlobalView.HEADER_TOP_COLOR}"/>
        </Grid>
        
        <!-- Bottom Buttons Panel -->
        <Grid Grid.Row="1" Margin="30,0,30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Close App Button (Left) -->
            <Button Grid.Column="0"
                    Content="Close App"
                    Command="{Binding CloseAppCommand}"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_2}"
                    Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"/>
            
            <!-- Version Text (Center) -->
            <TextBlock Grid.ColumnSpan="2"
                       Text="{Binding Version}"
                       FontSize="10"
                       Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            
            <!-- Start App Button and Checkbox (Right) -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <CheckBox Content="Start when ready"
                          IsChecked="{Binding StartWhenReady}"
                          Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                          Margin="0,0,0,8"
                          HorizontalAlignment="Right"/>
                <Button Content="Start App"
                        Command="{Binding StartAppCommand}"
                        Width="120"
                        Height="35"
                        HorizontalAlignment="Right"
                        Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_1}"
                        Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        IsEnabled="{Binding IsStartButtonEnabled}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Border>
</Window>
