<Window x:Class="Mams_App.src.launcher.LauncherWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:globalView="clr-namespace:Mams_App.src.globals"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
Title="{loc:Translate App.Title}"
    Width="{x:Static globalView:SGlobalView.LAUNCHER_WINDOW_WIDTH}"
    Height="{x:Static globalView:SGlobalView.LAUNCHER_WINDOW_HEIGHT}"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
<Border Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}" 
        CornerRadius="10" 
        BorderBrush="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}" 
        BorderThickness="2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="30,30,30,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Application Title -->
            <TextBlock Grid.Row="0"
                       Text="Mams"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <!-- Dynamic Content Area -->
            <ContentControl Grid.Row="1" Grid.RowSpan="3"
                            Content="{Binding CurrentView}"/>
        </Grid>
        
        <!-- Bottom Buttons Panel -->
        <Grid Grid.Row="1" Margin="30,0,30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Close App Button (Left) -->
            <Button Grid.Column="0"
                    Content="{loc:Translate Launcher.CloseApp}"
                    Command="{Binding CloseAppCommand}"
                    Width="120"
                    Height="35"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_2}"
                    Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"/>
            
            <!-- Version Text (Center) -->
            <TextBlock Grid.ColumnSpan="2"
                       Text="{Binding Version}"
                       FontSize="10"
                       Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            
            <!-- Start App Button and Checkbox (Right) -->
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <CheckBox Content="{loc:Translate Launcher.StartWhenReady}"
                          IsChecked="{Binding StartWhenReady}"
                          Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                          Margin="0,0,0,8"
                          HorizontalAlignment="Right"/>
                <Button Content="{loc:Translate Launcher.StartApp}"
                        Command="{Binding StartAppCommand}"
                        Width="120"
                        Height="35"
                        HorizontalAlignment="Right"
                        Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_1}"
                        Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        IsEnabled="{Binding IsStartButtonEnabled}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Border>
</Window>
