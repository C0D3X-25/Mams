<UserControl x:Class="Mams_App.src.launcher.userControls.UCCheckForUpdateView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:globalView="clr-namespace:Mams_App.src.globals"
mc:Ignorable="d" 
d:DesignHeight="200" d:DesignWidth="400"
d:Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status Text -->
        <TextBlock Grid.Row="0"
                   Text="{Binding StatusText}"
                   FontSize="14"
                   Foreground="{x:Static globalView:SGlobalView.DEFAULT_TEXT_COLOR}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   MaxWidth="380"/>

        <!-- Action Buttons Panel -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0"
                    Visibility="{Binding ActionButtonsVisibility}">
            <Button Content="{Binding YesButtonText}"
                    Command="{Binding YesCommand}"
                    Width="100"
                    Height="32"
                    Margin="0,0,10,0"
                    Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_1}"
                    Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button Content="{Binding NoButtonText}"
                    Command="{Binding NoCommand}"
                    Width="100"
                    Height="32"
                    Background="{x:Static globalView:SGlobalView.PAGE_BUTTON_COLOR_2}"
                    Foreground="{x:Static globalView:SGlobalView.PAGE_BUTTON_TEXT_COLOR}"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
