<Window x:Class="Mams_App.src.settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mams_App.src.settings"
        xmlns:globalView="clr-namespace:Mams_App.src.globals"
        xmlns:loc="clr-namespace:Mams_App.src.localizations"
        mc:Ignorable="d"
        Title="{loc:Translate Settings.Title}"
        Height="{x:Static globalView:SGlobalView.SETTINGS_WINDOW_HEIGHT}" 
        Width="{x:Static globalView:SGlobalView.SETTINGS_WINDOW_WIDTH}"
        MinHeight="{x:Static globalView:SGlobalView.SETTINGS_WINDOW_MIN_HEIGHT}" 
        MinWidth="{x:Static globalView:SGlobalView.SETTINGS_WINDOW_MIN_WIDTH}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
        
    <Window.Resources>
        <!-- File Size Converter -->
        <local:FileSizeConverter x:Key="FileSizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="{loc:Translate Settings.Title}" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <!-- Settings Content -->
        <TabControl Grid.Row="1">
            <!-- User Tab -->
            <TabItem Header="{loc:Translate Settings.User}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- User Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Translate Settings.UserInfo}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Translate Settings.UserInfoDescription}"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- User Fields -->
                    <Grid Grid.Row="1" Margin="0,5,0,5" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Form.Name}" 
                                   VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="0" Grid.Column="1" 
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5,3" Padding="5,3"/>

                        <!-- Phone -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Form.Phone}" 
                                   VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding UserPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5,3" Padding="5,3"/>

                        <!-- Email -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Translate Form.Email}" 
                                   VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5,3" Padding="5,3"/>

                        <!-- City -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Translate Form.City}" 
                                   VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="3" Grid.Column="1" 
                                 Text="{Binding UserCity, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5,3" Padding="5,3"/>

                        <!-- Address -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Translate Form.Address}" 
                                   VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox Grid.Row="4" Grid.Column="1" 
                                 Text="{Binding UserAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5,3" Padding="5,3"/>
                    </Grid>

                    <!-- Save Button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="{loc:Translate Common.Save}" 
                                Command="{Binding SaveUserCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="15,8"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Localisation Tab -->
            <TabItem Header="{loc:Translate Settings.Localization}" Height="20" VerticalAlignment="Top">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Localisation Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="{loc:Translate Settings.RegionalSettings}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Translate Settings.RegionalSettingsDescription}"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Language Selection -->
                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Language -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Translate Settings.Language}" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguageItem}"
                                  Margin="5" Padding="5"/>

                        <!-- Currency -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Translate Settings.Currency}" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" 
                                  ItemsSource="{Binding AvailableCurrencies}"
                                  SelectedItem="{Binding SelectedCurrencyItem}"
                                  Margin="5" Padding="5"/>
                    </Grid>

                    <!-- Settings Location -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="{loc:Translate Settings.SettingsLocation}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SettingsFilePath}" 
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <Button Content="{loc:Translate Settings.OpenFolder}" 
                                Command="{Binding OpenSettingsFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="15,5"
                                Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Save Button -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="{loc:Translate Common.Save}" 
                                Command="{Binding SaveLocalizationCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="20,10"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Backup Tab -->
            <TabItem Header="{loc:Translate Settings.BackupRestore}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Backup Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="{loc:Translate Settings.DatabaseBackups}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Translate Settings.BackupDescription}"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Backup Location -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="{loc:Translate Settings.BackupLocation}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BackupDirectory}" 
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <Button Content="{loc:Translate Settings.OpenFolder}" 
                                Command="{Binding OpenBackupFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="15,5"
                                Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Backup List -->
                    <GroupBox Grid.Row="2" Header="{loc:Translate Settings.AvailableBackups}" Margin="0,0,0,15">
                        <Grid>
                            <ListBox ItemsSource="{Binding Backups}" 
                                     SelectedItem="{Binding SelectedBackup}"
                                     Margin="5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Name}" 
                                                       FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding LastWriteTime, StringFormat='dd/MM/yyyy HH:mm'}"
                                                       Foreground="Gray"
                                                       Margin="20,0,10,0"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Length, Converter={StaticResource FileSizeConverter}}"
                                                       Foreground="Gray"
                                                       Width="70"
                                                       TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <!-- Empty state message -->
                            <TextBlock Text="{loc:Translate Settings.NoBackups}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </GroupBox>

                    <!-- Restore Button -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="{loc:Translate Settings.RestoreSelectedBackup}" 
                                Command="{Binding RestoreBackupCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding CanRestoreBackup}"
                                Padding="20,10"
                                FontWeight="SemiBold"/>
                        <Button Content="{loc:Translate Settings.RefreshList}" 
                                Command="{Binding RefreshBackupsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="15,10"
                                Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Integrity Tab -->
            <TabItem Header="{loc:Translate Settings.Integrity}">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Integrity Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="{loc:Translate Settings.IntegrityCheck}" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Translate Settings.IntegrityCheckDescription}"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Check Button -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <Button Content="{loc:Translate Settings.StartIntegrityCheck}" 
                                Command="{Binding StartIntegrityCheckCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="20,10"
                                FontWeight="SemiBold"
                                IsEnabled="{Binding CanStartIntegrityCheck}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- About Tab -->
            <TabItem Header="{loc:Translate Settings.About}">
                <StackPanel Margin="15">
                    <TextBlock Text="{loc:Translate Settings.AppName}" 
                               FontSize="16" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{loc:Translate Settings.AppDescription}"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="{loc:Translate Common.Close}" 
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="25,10"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>

    
</Window>
