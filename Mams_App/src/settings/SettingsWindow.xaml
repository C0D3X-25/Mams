<Window x:Class="Mams_App.src.settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mams_App.src.settings"
        xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
        mc:Ignorable="d"
        Title="Settings" 
        Height="{x:Static globalView:SGlobalView.SETTINGS_WINDOW_HEIGHT}" 
        Width="{x:Static globalView:SGlobalView.SETTINGS_WINDOW_WIDTH}"
        MinHeight="{x:Static globalView:SGlobalView.SETTINGS_WINDOW_MIN_HEIGHT}" 
        MinWidth="{x:Static globalView:SGlobalView.SETTINGS_WINDOW_MIN_WIDTH}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
        
    <Window.Resources>
        <!-- File Size Converter -->
        <local:FileSizeConverter x:Key="FileSizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Settings" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Settings Content -->
        <TabControl Grid.Row="1">
            <!-- User Tab -->
            <TabItem Header="Utilisateur">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- User Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Informations de l'utilisateur" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Ces informations apparaissent sur les factures générées."
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- User Fields -->
                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" 
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5" Padding="5"/>

                        <!-- Phone -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Téléphone:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" 
                                 Text="{Binding UserPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5" Padding="5"/>

                        <!-- Email -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" 
                                 Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5" Padding="5"/>

                        <!-- City -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ville:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" 
                                 Text="{Binding UserCity, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5" Padding="5"/>

                        <!-- Address -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Adresse:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="4" Grid.Column="1" 
                                 Text="{Binding UserAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="5" Padding="5"/>
                    </Grid>

                    <!-- Save Button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Enregistrer" 
                                Command="{Binding SaveUserCommand}"
                                Padding="20,10"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Localisation Tab -->
            <TabItem Header="Localisation">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Localisation Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Paramètres régionaux" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Configurez la devise et le format des nombres utilisés dans l'application."
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Currency Selection -->
                    <Grid Grid.Row="1" Margin="0,10,0,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*" MaxWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Devise / Région:" 
                                   VerticalAlignment="Center" Margin="0,5"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding AvailableCultures}"
                                  SelectedItem="{Binding SelectedCultureItem}"
                                  Margin="5" Padding="5"/>
                    </Grid>

                    <!-- Settings Location -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="Emplacement des paramètres:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SettingsFilePath}" 
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <Button Content="Ouvrir le dossier" 
                                Command="{Binding OpenSettingsFolderCommand}"
                                HorizontalAlignment="Left"
                                Padding="15,5"
                                Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Info message -->
                    <TextBlock Grid.Row="3" 
                               Text="Note: Les changements de localisation nécessitent un redémarrage de l'application."
                               Foreground="Gray"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top"
                               Margin="0,10,0,0"/>

                    <!-- Save Button -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Enregistrer" 
                                Command="{Binding SaveLocalizationCommand}"
                                Padding="20,10"
                                FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Backup Tab -->
            <TabItem Header="Backup &amp; Restore">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Backup Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Database Backups" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Select a backup to restore your database to a previous state."
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Backup Location -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Backup Location:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BackupDirectory}" 
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <Button Content="Open Folder" 
                                Command="{Binding OpenBackupFolderCommand}"
                                HorizontalAlignment="Left"
                                Padding="15,5"
                                Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Backup List -->
                    <GroupBox Grid.Row="2" Header="Available Backups" Margin="0,0,0,15">
                        <Grid>
                            <ListBox ItemsSource="{Binding Backups}" 
                                     SelectedItem="{Binding SelectedBackup}"
                                     Margin="5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Name}" 
                                                       FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding LastWriteTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                       Foreground="Gray"
                                                       Margin="20,0,10,0"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Length, Converter={StaticResource FileSizeConverter}}"
                                                       Foreground="Gray"
                                                       Width="70"
                                                       TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <!-- Empty state message -->
                            <TextBlock Text="No backups available"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </GroupBox>

                    <!-- Restore Button -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Restore Selected Backup" 
                                Command="{Binding RestoreBackupCommand}"
                                IsEnabled="{Binding CanRestoreBackup}"
                                Padding="20,10"
                                FontWeight="SemiBold"/>
                        <Button Content="Refresh List" 
                                Command="{Binding RefreshBackupsCommand}"
                                Padding="15,10"
                                Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- About Tab -->
            <TabItem Header="About">
                <StackPanel Margin="15">
                    <TextBlock Text="Mams Application" 
                               FontSize="16" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="Database management and backup system."
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Close" 
                    Command="{Binding CloseCommand}"
                    Padding="25,10"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>

    
</Window>
