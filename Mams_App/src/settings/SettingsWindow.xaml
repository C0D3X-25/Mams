<Window x:Class="Mams_App.src.settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mams_App.src.settings"
        xmlns:globalView="clr-namespace:Mams_App.src.views.globalView"
        mc:Ignorable="d"
        Title="Settings" 
        Height="{x:Static globalView:SGlobalViewSize.SETTINGS_WINDOW_HEIGHT}" 
        Width="{x:Static globalView:SGlobalViewSize.SETTINGS_WINDOW_WIDTH}"
        MinHeight="{x:Static globalView:SGlobalViewSize.SETTINGS_WINDOW_MIN_HEIGHT}" 
        MinWidth="{x:Static globalView:SGlobalViewSize.SETTINGS_WINDOW_MIN_WIDTH}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
        
    <Window.Resources>
        <!-- File Size Converter -->
        <local:FileSizeConverter x:Key="FileSizeConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Settings" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Settings Content -->
        <TabControl Grid.Row="1">
            <!-- Backup Tab -->
            <TabItem Header="Backup &amp; Restore">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Backup Section Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Database Backups" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Select a backup to restore your database to a previous state."
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Backup Location -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Backup Location:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BackupDirectory}" 
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                        <Button Content="Open Folder" 
                                Command="{Binding OpenBackupFolderCommand}"
                                HorizontalAlignment="Left"
                                Padding="15,5"
                                Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Backup List -->
                    <GroupBox Grid.Row="2" Header="Available Backups" Margin="0,0,0,15">
                        <Grid>
                            <ListBox ItemsSource="{Binding Backups}" 
                                     SelectedItem="{Binding SelectedBackup}"
                                     Margin="5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Name}" 
                                                       FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding LastWriteTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                       Foreground="Gray"
                                                       Margin="20,0,10,0"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Length, Converter={StaticResource FileSizeConverter}}"
                                                       Foreground="Gray"
                                                       Width="70"
                                                       TextAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <!-- Empty state message -->
                            <TextBlock Text="No backups available"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </GroupBox>

                    <!-- Restore Button -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="Restore Selected Backup" 
                                Command="{Binding RestoreBackupCommand}"
                                IsEnabled="{Binding CanRestoreBackup}"
                                Padding="20,10"
                                FontWeight="SemiBold"/>
                        <Button Content="Refresh List" 
                                Command="{Binding RefreshBackupsCommand}"
                                Padding="15,10"
                                Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Placeholder for future settings tabs -->
            <TabItem Header="About">
                <StackPanel Margin="15">
                    <TextBlock Text="Mams Application" 
                               FontSize="16" 
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Version 1.0.0"
                               Foreground="Gray"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="Database management and backup system."
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Close" 
                    Command="{Binding CloseCommand}"
                    Padding="25,10"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>

    
</Window>
