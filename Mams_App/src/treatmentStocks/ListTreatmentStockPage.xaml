<Page x:Class="Mams_App.src.treatmentStocks.ListTreatmentStockPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
xmlns:local="clr-namespace:Mams_App.src.treatmentStocks"
xmlns:userControls="clr-namespace:Mams_App.src.mainWindow.userControls"
xmlns:commands="clr-namespace:Mams_App.src.commands"
xmlns:globalView="clr-namespace:Mams_App.src.globals"
xmlns:loc="clr-namespace:Mams_App.src.localizations"
xmlns:converters="clr-namespace:Mams_App.src.converters"
xmlns:helpers="clr-namespace:Mams_App.src.helpers"
mc:Ignorable="d" 
d:DesignHeight="{x:Static globalView:SGlobalView.PAGE_DESIGN_HEIGHT}" 
d:DesignWidth="{x:Static globalView:SGlobalView.PAGE_DESIGN_WIDTH}"
Title="ListTreatmentStockPage">

    <Page.Resources>
        <converters:SortArrowConverter x:Key="SortArrowConverter"/>
    </Page.Resources>

    <Grid Background="{x:Static globalView:SGlobalView.PAGE_FRAME_COLOR}">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" MaxHeight="50"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="1*" MaxHeight="25"/>
        </Grid.RowDefinitions>

        <!--Header-->
        <userControls:UCHeader 
            Grid.Row="0"
            title="{loc:Translate Page.ListTreatmentStocks}"/>

        <!--Body-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="200"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <!--Menu-->
            <userControls:UCMenu/>

            <!--Content-->
            <Grid 
                Grid.Column="1" 
                Background="{x:Static globalView:SGlobalView.PAGE_BODY_COLOR}" 
                Margin="3,3,10,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="9*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!--List of Treatment Stocks-->
                <Grid Grid.Row="1" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <ListView 
                        Grid.Column="1" 
                        Margin="0,0,0,10"
                        MinWidth="500"
                        FontSize="14"
                        ItemsSource="{Binding m_list_items}"
                        SelectedItem="{Binding m_selected_item}"
                        commands:MouseCommand.MouseDoubleClickCommand="{Binding m_double_click_command}">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Command" Value="{Binding DataContext.m_sort_command, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                                <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}, Path=Column}"/>
                            </Style>
                            
                            <DataTemplate x:Key="HeaderTemplateWithArrow">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}"/>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="Column.DisplayMemberBinding.Path.Path"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_sorted_column"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.m_sort_direction"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType=GridViewColumnHeader}" Path="Column.(helpers:SortPathAttached.SortPath)"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{loc:Translate Column.Date}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_stock_purchase_date}"/>
                                <GridViewColumn Header="{loc:Translate Column.Product}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding product_name}"/>
                                <GridViewColumn Header="{loc:Translate Column.Supplier}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding supplier_name}"/>
                                <GridViewColumn Header="{loc:Translate Column.DoseUnit}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding dose_unit_name}"/>
                                <GridViewColumn Header="{loc:Translate Column.InitialQuantity}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_stock_initial_quantity}"/>
                                <GridViewColumn Header="{loc:Translate Column.UsedQuantity}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_stock_used_quantity}"/>
                                <GridViewColumn Header="{loc:Translate Column.RemainingQuantity}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_stock_remaining_quantity}"/>
                                <GridViewColumn Header="{loc:Translate Column.FirstUsed}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_stock_first_used_date}"/>
                                <GridViewColumn Header="{loc:Translate Column.LastUsed}" HeaderTemplate="{StaticResource HeaderTemplateWithArrow}" DisplayMemberBinding="{Binding treatment_stock_last_used_date}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <!--Bottom Buttons-->
                <Grid Grid.Row="2">
                    <!--Delete Button (Left)-->
                    <StackPanel 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Margin="50,0,0,0">
                        <Button 
                            Content="{Binding m_delete_button_text}"
                            Command="{Binding m_delete_command}"
                            Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>

                    <!--Edit and Add Buttons (Right)-->
                    <StackPanel 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Margin="0,0,50,0">
                        <Button 
                            Content="{loc:Translate Common.Edit}"
                            Command="{Binding m_modify_command}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button 
                            Content="{loc:Translate Button.NewTreatmentStock}"
                            Command="{Binding m_add_command}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!--Footer-->
        <userControls:UCFooter Grid.Row="2"/>
    </Grid>
</Page>
