<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '15.0'">
    <VisualStudioVersion>15.0</VisualStudioVersion>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x86">
      <Configuration>Debug</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x86">
      <Configuration>Release</Configuration>
      <Platform>x86</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM">
      <Configuration>Debug</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM">
      <Configuration>Release</Configuration>
      <Platform>ARM</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|AnyCPU">
      <Configuration>Debug</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|AnyCPU">
      <Configuration>Release</Configuration>
      <Platform>AnyCPU</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <!--
    Microsoft.DesktopBridge.* is installed by Visual Studio's "MSIX Packaging Tools"
    component (Microsoft.VisualStudio.ComponentGroup.MSIX.Packaging). It is not part
    of the .NET SDK. `dotnet build` sets MSBuildExtensionsPath to the SDK folder, so
    an unconditional import fails with MSB4019. Use the targets when they exist, and
    otherwise skip packaging so the rest of the solution still builds.
  -->
  <PropertyGroup>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(WapProjPath)Microsoft.DesktopBridge.props') and Exists('$(WapProjPath)Microsoft.DesktopBridge.targets')">$(WapProjPath)</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(WapProjPath)\Microsoft.DesktopBridge.props') and Exists('$(WapProjPath)\Microsoft.DesktopBridge.targets')">$(WapProjPath)\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(MSBuildExtensionsPath32)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildExtensionsPath32)\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(VsInstallRoot)\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(VsInstallRoot)\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(ProgramW6432)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(ProgramW6432)\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(ProgramW6432)\Microsoft Visual Studio\18\Professional\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(ProgramW6432)\Microsoft Visual Studio\18\Professional\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(ProgramW6432)\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(ProgramW6432)\Microsoft Visual Studio\18\Enterprise\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(ProgramW6432)\Microsoft Visual Studio\18\BuildTools\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(ProgramW6432)\Microsoft Visual Studio\18\BuildTools\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(ProgramW6432)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(ProgramW6432)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(ProgramW6432)\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(ProgramW6432)\Microsoft Visual Studio\2022\Professional\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(ProgramW6432)\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(ProgramW6432)\Microsoft Visual Studio\2022\Enterprise\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(ProgramW6432)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(ProgramW6432)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <_WapCandidate Condition="'$(_WapCandidate)' == '' and Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\BuildTools\MSBuild\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props')">$(MSBuildProgramFiles32)\Microsoft Visual Studio\18\BuildTools\MSBuild\Microsoft\DesktopBridge\</_WapCandidate>
    <WapProjPath Condition="'$(_WapCandidate)' != ''">$(_WapCandidate)</WapProjPath>
    <DesktopBridgePropsPath>$(WapProjPath)Microsoft.DesktopBridge.props</DesktopBridgePropsPath>
    <DesktopBridgeTargetsPath>$(WapProjPath)Microsoft.DesktopBridge.targets</DesktopBridgeTargetsPath>
    <DesktopBridgeAvailable Condition="Exists('$(DesktopBridgePropsPath)') and Exists('$(DesktopBridgeTargetsPath)')">true</DesktopBridgeAvailable>
  </PropertyGroup>
  <Import Project="$(DesktopBridgePropsPath)" Condition="'$(DesktopBridgeAvailable)' == 'true'" />
  <PropertyGroup>
    <ProjectGuid>2ff51643-60d1-4ec3-8d3e-e45beca12ff0</ProjectGuid>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <NoWarn>$(NoWarn);NU1702</NoWarn>
    <EntryPointProjectUniqueName>..\Mams_App\Mams_App.csproj</EntryPointProjectUniqueName>
    <!--<PackageCertificateThumbprint>E788C8977B0F071A901F454DEE2A39422B3DA5D6</PackageCertificateThumbprint>-->
  </PropertyGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
