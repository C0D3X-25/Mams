<Page x:Class="Mams.src.productsTypes.SaveProductTypePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mams.src.productsTypes"
      xmlns:userControls="clr-namespace:Mams.src.views.userControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SaveProductTypePage">

    <Grid>
        <!--Page is 12* per 12*-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MaxHeight="100"/>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*" MaxHeight="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*"/>
            </Grid.ColumnDefinitions>

            <!--Header-->
            <userControls:UCHeader 
                x:Name="header" 
                Grid.Row="0"
                title="Type de produit"

            ></userControls:UCHeader>
            <!--Header-->

            <!--Body-->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="200"/>
                    <!--For menu-->
                    <ColumnDefinition Width="10*"/>
                    <!--For content-->
                </Grid.ColumnDefinitions>

                <!--Menu-->
                <userControls:UCMenu

                ></userControls:UCMenu>
                <!--Menu-->

                <!--Content-->
                <Grid Grid.Column="1" Background="#FFE0A5A5" Margin="3,3,10,3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="9*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!--Fields-->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!--Left Grid-->
                            <Grid Grid.Column="0" Grid.Row="1" 
                                  HorizontalAlignment="Right"
                                  Margin="0,0,25,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="7*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!--Name-->
                                <userControls:UCLabelTextBox
                                    Grid.Row="0"
                                    label="Nom du type*"
                                    text="{Binding m_product_type.product_type_name, UpdateSourceTrigger=PropertyChanged}"
                                
                                ></userControls:UCLabelTextBox>
                            </Grid>

                            <!--Right Grid-->
                            <Grid Grid.Column="1" Grid.Row="1" 
                                  HorizontalAlignment="Left"
                                  Margin="25,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="7*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>


                                <!--ID-->
                                <userControls:UCLabelTextBox
                                    Grid.Row="0"
                                    label="ID"
                                    text="{Binding m_product_type.product_type_id, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="Visible"
                                ></userControls:UCLabelTextBox>
                            </Grid>
                        </Grid>

                        <!--Abort Save Buttons-->
                        <Button 
                            Grid.Row="2"
                            Content="Enregistrer"
                            Command="{Binding m_save_command}"
                            Height="30" Width="130"
                            MaxHeight="30" MaxWidth="130"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,50,0"
                            FontSize="16"
                        ></Button>

                        <Button 
                            Grid.Row="2"
                            Content="Annuler"
                            Command="{Binding m_abort_command}"
                            Height="30" Width="130"
                            MaxHeight="30" MaxWidth="130"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="50,0,0,0"
                            FontSize="16"
                        ></Button>
                    </Grid>
                </Grid>
                <!--Content-->
            </Grid>
            <!--Body-->

            <!--Footer-->
            <userControls:UCFooter x:Name="footer" Grid.Row="2">

            </userControls:UCFooter>
            <!--Footer-->
        </Grid>
        <!--Page-->
    </Grid>
</Page>
