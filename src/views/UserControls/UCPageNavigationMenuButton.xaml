<UserControl x:Class="Mams.src.views.userControls.UCPageNavigationMenuButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams.src.views.userControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="130">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button x:Name="menu_button" Grid.Row="0" FontSize="16" Margin="3"
                Content="{Binding Content, RelativeSource={RelativeSource AncestorType={x:Type local:UCPageNavigationMenuButton}}}"
                Command="{Binding Command, RelativeSource={RelativeSource AncestorType={x:Type local:UCPageNavigationMenuButton}}}">
        </Button>
    </Grid>
</UserControl>
