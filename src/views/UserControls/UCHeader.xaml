<UserControl x:Class="Mams.src.views.userControls.UCHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams.src.views.userControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="1000"
             x:Name="root">
    
    <!--Header-->
    <Grid x:Name="header_grid" Grid.Row="0" Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <!--Title-->
        <Label x:Name="title_page_lbl" 
               Content="{Binding title, ElementName=root}" 
               FontSize="25" FontWeight="Bold" 
               HorizontalAlignment="Center" VerticalAlignment="Center">
            
        </Label>

        <!--Header Menu-->
        <Grid Grid.Row="1" Background="#FFE25F5F">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--Home Menu-->
            <Grid Grid.Row="0" Background="#FFE25F5F">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button 
                    Content="Home" 
                    Grid.Column="0" Margin="10,0,0,0" 
                    VerticalAlignment="Center" HorizontalAlignment="Left" 
                    MinHeight="40" MinWidth="40"
                    Command="{Binding m_navigate_homepage_command}"/>
            </Grid>
            
            <!--Searchbar-->
            <local:UCLabelTextBoxSearch
                Grid.Column="1"
                label=""
                >
            </local:UCLabelTextBoxSearch>
            <!--
            <Grid Grid.Column="1" Background="#FFE25F5F" MaxWidth="500" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="searchbar_cmbBox" 
                          Grid.Column="0" 
                          Margin="50,0,0,0" 
                          VerticalAlignment="Center">
                    
                </ComboBox>

                <TextBox x:Name="searchbar_txtBox" 
                         Grid.Column="1" 
                         Margin="1,0,50,0" 
                         FontSize="16" 
                         VerticalAlignment="Center" 
                         TextChanged="searchbar_txtBox_TextChanged">
                    
                </TextBox>
                
                --><!-- Popup for ListView --><!--
                <Popup x:Name="searchPopup" 
                       Grid.Column="1" 
                       PlacementTarget="{Binding ElementName=searchbar_txtBox}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Slide">
                    <ListView x:Name="searchbar_listView"
                            Width="{Binding ElementName=searchbar_txtBox, Path=ActualWidth}"
                            Background="White"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            FontSize="16"
                            SelectionChanged="searchbar_listView_SelectionChanged">
                        
                    </ListView>
                </Popup>
            </Grid>-->
            <!--Searchbar-->
        </Grid>
        <!--Header Menu-->
    </Grid>
    <!--Header-->
</UserControl>
