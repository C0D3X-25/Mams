<UserControl x:Class="Mams.src.views.UserControls.UCAddNewButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mams.src.views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800"
             x:Name="root">
    <Grid>

        <!--Add New Button-->
        <Button x:Name="add_new_btn" 
            Content="{Binding label_add_new_button, ElementName=root}"
            Command="{Binding add_new_command}"
            Grid.Column="2" Grid.Row="5" 
            Height="30" Width="120"
            HorizontalAlignment="Right"
            Margin="0,0,50,0"
            FontSize="16">

        </Button>
    </Grid>
</UserControl>
