<Page x:Class="Mams.src.resumes.ResumePage"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
     xmlns:local="clr-namespace:Mams.src.resumes"
     xmlns:userControls="clr-namespace:Mams.src.views.UserControls"
     mc:Ignorable="d" 
     d:DesignHeight="800" d:DesignWidth="1224"
     Title="ResumePage">

   <Grid>
       <!--Page is 12* per 12*-->
       <Grid>
           <Grid.RowDefinitions>
               <RowDefinition Height="2*" MaxHeight="100"/>
               <RowDefinition Height="9*"/>
               <RowDefinition Height="1*" MaxHeight="50"/>
           </Grid.RowDefinitions>
           <Grid.ColumnDefinitions>
               <ColumnDefinition Width="12*"/>
           </Grid.ColumnDefinitions>

           <!--Header-->
            <userControls:UCHeader 
               Grid.Row="0"
               title="Résumé">

            </userControls:UCHeader>

            <!--Body-->
           <Grid Grid.Row="1">
               <Grid.RowDefinitions>
                   <RowDefinition/>
               </Grid.RowDefinitions>
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="2*" MaxWidth="200"/>
                   <!--For menu-->
                   <ColumnDefinition Width="10*"/>
                   <!--For content-->
               </Grid.ColumnDefinitions>

               <!--Menu-->
                <userControls:UCMenu>

                </userControls:UCMenu>

                <!--Content-->
               <Grid Grid.Column="1" 
                     Background="#FFE0A5A5" 
                     Margin="3,3,10,3">
                   <Grid.RowDefinitions>
                       <RowDefinition/>
                   </Grid.RowDefinitions>
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition/>
                   </Grid.ColumnDefinitions>

                   <Grid>
                       <Grid.RowDefinitions>
                           <RowDefinition Height="1*"/>
                           <RowDefinition Height="9*"/>
                           <RowDefinition Height="2*"/>
                       </Grid.RowDefinitions>
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition/>
                       </Grid.ColumnDefinitions>
                       
                       <!--Search Bar-->
                       <Grid>
                           <Grid.RowDefinitions>
                               <RowDefinition/>
                           </Grid.RowDefinitions>
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="1*"/>
                               <ColumnDefinition Width="1*"/>
                               <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                           <Label
                               Grid.Column="0" Grid.Row="0" 
                               Content="Rechercher par :"
                               FontSize="16" 
                               VerticalAlignment="Center" HorizontalAlignment="Right"

                           ></Label>

                           <!--Search in table-->
                           <ComboBox
                               Grid.Column="1" Grid.Row="0" 
                               Margin="5,0,5,0" 
                               FontSize="16" 
                               VerticalAlignment="Center"
                               ItemsSource="{Binding m_list_table, UpdateSourceTrigger=PropertyChanged}"
                               SelectedItem="{Binding m_selected_table, UpdateSourceTrigger=PropertyChanged}">
                               <ComboBox.ItemTemplate>
                                   <DataTemplate>
                                        <TextBlock Text="{Binding m_name_to_display, UpdateSourceTrigger=PropertyChanged}"/>
                                   </DataTemplate>
                               </ComboBox.ItemTemplate>
                           </ComboBox>

                            <!--Search by value-->
                            <ComboBox
                               Grid.Column="2" Grid.Row="0" 
                               Margin="5,0,5,0" 
                               FontSize="16" 
                               VerticalAlignment="Center"
                               ItemsSource="{Binding m_list_search_item, UpdateSourceTrigger=PropertyChanged}"
                               SelectedItem="{Binding m_selected_search_item, UpdateSourceTrigger=PropertyChanged}">
                               <ComboBox.ItemTemplate>
                                   <DataTemplate>
                                        <TextBlock Text="{Binding search_item_to_display, UpdateSourceTrigger=PropertyChanged}"/>
                                   </DataTemplate>
                               </ComboBox.ItemTemplate>
                           </ComboBox>

                            <Label
                               Grid.Column="3" Grid.Row="0" 
                               Content="Pour l'année :"
                               FontSize="16" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"

                           ></Label>

                            <!--Search by year-->
                            <ComboBox
                               Grid.Column="4" Grid.Row="0" 
                               Margin="5,0,5,0" 
                               FontSize="16" 
                               VerticalAlignment="Center"
                               ItemsSource="{Binding m_list_year, UpdateSourceTrigger=PropertyChanged}"
                               SelectedItem="{Binding m_selected_year, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding search_year, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                       <!--Resume Views-->
                       <Grid Grid.Column="0" Grid.Row="1"
                             Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="10*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Label 
                               Grid.Column="0" Grid.Row="0"
                               Content="Bénéfices" 
                               FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               
                           ></Label>

                           <!--Profit-->
                           <ListView
                               Grid.Column="0" Grid.Row="1"
                               FontSize="14"
                               Margin="0,0,5,0"
                               ItemsSource="{Binding m_list_profit_item}">
                               <ListView.View>
                                   <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding receipt_id}"/>
                                        <GridViewColumn Header="Client" DisplayMemberBinding="{Binding client_name}"/>
                                        <GridViewColumn Header="Produit" DisplayMemberBinding="{Binding product_name}"/>
                                        <GridViewColumn Header="Date" DisplayMemberBinding="{Binding profit_date}"/>
                                        <GridViewColumn Header="Quantité" DisplayMemberBinding="{Binding profit_quantity}"/>
                                        <GridViewColumn Header="Prix Unité" DisplayMemberBinding="{Binding profit_price_unity}"/>
                                        <GridViewColumn Header="Prix Total" DisplayMemberBinding="{Binding profit_price_total}"/>
                                   </GridView>
                               </ListView.View>
                           </ListView>

                            <Label 
                               Grid.Column="1" Grid.Row="0"
                               Content="Frais" 
                               FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               
                           ></Label>

                            <!--Fees-->
                           <ListView
                               Grid.Column="1" Grid.Row="1"
                               FontSize="14"
                               Margin="5,0,0,0"
                               ItemsSource="{Binding m_list_fee_item}">
                               <ListView.View>
                                   <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding receipt_id}"/>
                                        <GridViewColumn Header="Fournisseur" DisplayMemberBinding="{Binding supplier_name}"/>
                                        <GridViewColumn Header="Produit" DisplayMemberBinding="{Binding product_name}"/>
                                        <GridViewColumn Header="Date" DisplayMemberBinding="{Binding fee_date}"/>
                                        <GridViewColumn Header="Quantité" DisplayMemberBinding="{Binding fee_quantity}"/>
                                        <GridViewColumn Header="Prix Unité" DisplayMemberBinding="{Binding fee_price_unity}"/>
                                        <GridViewColumn Header="Prix Total" DisplayMemberBinding="{Binding fee_price_total}"/>
                                   </GridView>
                               </ListView.View>
                           </ListView>
                       </Grid>


                       <Grid Grid.Column="0" Grid.Row="2"
                             Margin="5">
                           <Grid.RowDefinitions>
                               <RowDefinition/>
                               <RowDefinition/>
                               <RowDefinition/>
                           </Grid.RowDefinitions>
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition/>
                               <ColumnDefinition/>
                           </Grid.ColumnDefinitions>
                           
                           <!--Total Label-->
                           <Label
                               Grid.Column="0" Grid.Row="0"
                               HorizontalContentAlignment="Right"
                               FontSize="16"
                               Content="Total Bénéfices :"
                           ></Label>
                           <Label
                               Grid.Column="0" Grid.Row="1"
                               HorizontalContentAlignment="Right"
                               FontSize="16"
                               Content="Total Frais :"
                           ></Label>
                           <Label
                               Grid.Column="0" Grid.Row="2"
                               HorizontalContentAlignment="Right"
                               FontSize="16"
                               Content="Total :"
                           ></Label>

                           <!--Total Value-->
                           <Label
                               Grid.Column="1" Grid.Row="0"
                               HorizontalContentAlignment="Left"
                               FontSize="16"
                               Content="{Binding m_total_profit}"
                           ></Label>
                           <Label
                               Grid.Column="1" Grid.Row="1"
                               HorizontalContentAlignment="Left"
                               FontSize="16"
                               Foreground="{Binding m_total_fee_color}"
                               Content="{Binding m_total_fee}"
                           ></Label>
                           <Label
                               Grid.Column="1" Grid.Row="2"
                               HorizontalContentAlignment="Left"
                               FontSize="16"
                               Foreground="{Binding m_total_color}"
                               Content="{Binding m_total}"
                           ></Label>
                       </Grid>
                   </Grid>
               </Grid>
           </Grid>

           <!--Footer-->
           <userControls:UCFooter 
               x:Name="footer" Grid.Row="2">

           </userControls:UCFooter>
       </Grid>
   </Grid>
</Page>
