<Page x:Class="Mams.src.resumes.ResumePage"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
     xmlns:local="clr-namespace:Mams.src.resumes"
     xmlns:userControls="clr-namespace:Mams.src.views.UserControls"
     mc:Ignorable="d" 
     d:DesignHeight="800" d:DesignWidth="1224"
     Title="ResumePage">

   <Grid>
       <!--Page is 12* per 12*-->
       <Grid>
           <Grid.RowDefinitions>
               <RowDefinition Height="2*" MaxHeight="100"/>
               <RowDefinition Height="9*"/>
               <RowDefinition Height="1*" MaxHeight="50"/>
           </Grid.RowDefinitions>
           <Grid.ColumnDefinitions>
               <ColumnDefinition Width="12*"/>
           </Grid.ColumnDefinitions>

           <!--Header-->
           <userControls:UCHeader 
               x:Name="header" 
               Grid.Row="0"
               title="Résumé">

           </userControls:UCHeader>
           <!--Header-->

           <!--Body-->
           <Grid Grid.Row="1">
               <Grid.RowDefinitions>
                   <RowDefinition/>
               </Grid.RowDefinitions>
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="2*" MaxWidth="200"/>
                   <!--For menu-->
                   <ColumnDefinition Width="10*"/>
                   <!--For content-->
               </Grid.ColumnDefinitions>

               <!--Menu-->
               <userControls:UCMenu x:Name="pages_menu">

               </userControls:UCMenu>
               <!--Menu-->

               <!--Content-->
               <Grid Grid.Column="1" 
                     Background="#FFE0A5A5" 
                     Margin="3,3,10,3">
                   <Grid.RowDefinitions>
                       <RowDefinition/>
                   </Grid.RowDefinitions>
                   <Grid.ColumnDefinitions>
                       <ColumnDefinition/>
                   </Grid.ColumnDefinitions>

                   <Grid>
                       <Grid.RowDefinitions>
                           <RowDefinition Height="1*"/>
                           <RowDefinition Height="9*"/>
                           <RowDefinition Height="2*"/>
                       </Grid.RowDefinitions>
                       <Grid.ColumnDefinitions>
                           <ColumnDefinition/>
                       </Grid.ColumnDefinitions>
                       
                       <!--Search Bar-->
                       <Grid>
                           <Grid.RowDefinitions>
                               <RowDefinition/>
                           </Grid.RowDefinitions>
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="1*"/>
                               <ColumnDefinition Width="1*"/>
                               <ColumnDefinition Width="2*"/>
                               <ColumnDefinition Width="2*"/>
                           </Grid.ColumnDefinitions>

                           <Label
                               Grid.Column="0" Grid.Row="0" 
                               Content="Rechercher par :"
                               FontSize="16" 
                               VerticalAlignment="Center" HorizontalAlignment="Right"

                           ></Label>

                           <ComboBox
                               Grid.Column="1" Grid.Row="0" 
                               Margin="5,0,5,0" 
                               FontSize="16" 
                               VerticalAlignment="Center"
                               ItemsSource="{Binding m_list_beehive, UpdateSourceTrigger=PropertyChanged}"
                               SelectedItem="{Binding m_selected_beehive, UpdateSourceTrigger=PropertyChanged}">
                               <ComboBox.ItemTemplate>
                                   <DataTemplate>
                                       <TextBlock Text="{Binding beehive_name, UpdateSourceTrigger=PropertyChanged}"/>
                                   </DataTemplate>
                               </ComboBox.ItemTemplate>
                           </ComboBox>

                           <ComboBox
                               Grid.Column="2" Grid.Row="0" 
                               Margin="5,0,5,0" 
                               FontSize="16" 
                               VerticalAlignment="Center"
                               ItemsSource="{Binding m_list_beehive, UpdateSourceTrigger=PropertyChanged}"
                               SelectedItem="{Binding m_selected_beehive, UpdateSourceTrigger=PropertyChanged}">
                               <ComboBox.ItemTemplate>
                                   <DataTemplate>
                                       <TextBlock Text="{Binding beehive_name, UpdateSourceTrigger=PropertyChanged}"/>
                                   </DataTemplate>
                               </ComboBox.ItemTemplate>
                           </ComboBox>
                       </Grid>

                       <!--Resume Views-->
                       <Grid Grid.Column="0" Grid.Row="1"
                             Margin="5">
                           <Grid.RowDefinitions>
                               <RowDefinition Height="1*"/>
                               <RowDefinition Height="10*"/>
                           </Grid.RowDefinitions>
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition/>
                               <ColumnDefinition/>
                           </Grid.ColumnDefinitions>

                           <Label 
                               Grid.Column="0" Grid.Row="0"
                               Content="Frais" 
                               FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               
                           ></Label>

                           <Label 
                               Grid.Column="1" Grid.Row="0"
                               Content="Bénéfices" 
                               FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               
                           ></Label>

                           <!--Fees-->
                           <ListView
                               Grid.Column="0" Grid.Row="1"
                               FontSize="14"
                               Margin="0,0,5,0"
                               ItemsSource="{Binding m_list_items}"
                               SelectedItem="{Binding m_selected_item}">
                               <ListView.View>
                                   <GridView>
                                       <GridViewColumn Header="ID" DisplayMemberBinding="{Binding product_lot_id}"/>
                                       <GridViewColumn Header="Produit" DisplayMemberBinding="{Binding product_lot_name}"/>
                                       <GridViewColumn Header="Année" DisplayMemberBinding="{Binding product_lot_year}"/>
                                       <GridViewColumn Header="Prix Unité" DisplayMemberBinding="{Binding beehive_name}"/>
                                       <GridViewColumn Header="Prix Total" DisplayMemberBinding="{Binding product_lot_archive}"/>
                                   </GridView>
                               </ListView.View>
                           </ListView>

                           <!--Profil-->
                           <ListView
                               Grid.Column="1" Grid.Row="1"
                               FontSize="14"
                               Margin="5,0,0,0"
                               ItemsSource="{Binding m_list_items}"
                               SelectedItem="{Binding m_selected_item}">
                               <ListView.View>
                                   <GridView>
                                       <GridViewColumn Header="ID" DisplayMemberBinding="{Binding product_lot_id}"/>
                                       <GridViewColumn Header="Produit" DisplayMemberBinding="{Binding product_lot_name}"/>
                                       <GridViewColumn Header="Année" DisplayMemberBinding="{Binding product_lot_year}"/>
                                       <GridViewColumn Header="Prix Unité" DisplayMemberBinding="{Binding beehive_name}"/>
                                       <GridViewColumn Header="Prix Total" DisplayMemberBinding="{Binding product_lot_archive}"/>
                                   </GridView>
                               </ListView.View>
                           </ListView>
                       </Grid>

                       <Grid Grid.Column="0" Grid.Row="2"
                             Margin="5">
                           <Grid.RowDefinitions>
                               <RowDefinition/>
                               <RowDefinition/>
                               <RowDefinition/>
                           </Grid.RowDefinitions>
                           <Grid.ColumnDefinitions>
                               <ColumnDefinition/>
                               <ColumnDefinition/>
                           </Grid.ColumnDefinitions>
                           
                           <!--Total Label-->
                           <Label
                               Grid.Column="0" Grid.Row="1"
                               HorizontalContentAlignment="Right"
                               FontSize="16"
                               Content="Total Bénéfices :"
                           ></Label>
                           <Label
                               Grid.Column="0" Grid.Row="0"
                               HorizontalContentAlignment="Right"
                               FontSize="16"
                               Content="Total Frais :"
                           ></Label>
                           <Label
                               Grid.Column="0" Grid.Row="2"
                               HorizontalContentAlignment="Right"
                               FontSize="16"
                               Content="Total :"
                           ></Label>

                           <!--Total Value-->
                           <Label
                               Grid.Column="1" Grid.Row="0"
                               HorizontalContentAlignment="Left"
                               FontSize="16"
                               Content="000"
                           ></Label>
                           <Label
                               Grid.Column="1" Grid.Row="1"
                               HorizontalContentAlignment="Left"
                               FontSize="16"
                               Content="000"
                           ></Label>
                           <Label
                               Grid.Column="1" Grid.Row="2"
                               HorizontalContentAlignment="Left"
                               FontSize="16"
                               Content="000"
                           ></Label>
                       </Grid>
                   </Grid>
               </Grid>
           </Grid>

           <!--Footer-->
           <userControls:UCFooter 
               x:Name="footer" Grid.Row="2">

           </userControls:UCFooter>
       </Grid>
   </Grid>
</Page>
