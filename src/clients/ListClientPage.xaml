<Page xmlns:UserControls="clr-namespace:Mams.src.views.userControls"  
      x:Class="Mams.src.clients.ListClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mams.src.clients"
      xmlns:userControls="clr-namespace:Mams.src.views.userControls"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="ListClientPage">

    <Grid>
        <!--Page is 12* per 12*-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MaxHeight="100"/>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*" MaxHeight="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*"/>
            </Grid.ColumnDefinitions>

            <!--Header-->
            <userControls:UCHeader 
                x:Name="header" 
                Grid.Row="0"
                title="Liste Clients">

            </userControls:UCHeader>
            <!--Header-->

            <!--Body-->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="200"/>
                    <!--For menu-->
                    <ColumnDefinition Width="10*"/>
                    <!--For content-->
                </Grid.ColumnDefinitions>

                <!--Menu-->
                <userControls:UCMenu x:Name="pages_menu">

                </userControls:UCMenu>
                <!--Menu-->

                <!--Content-->
                <Grid Grid.Column="1" Background="#FFE0A5A5" Margin="3,3,10,3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="10*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!--CheckBox Archived-->
                        <CheckBox 
                            Grid.Row="0"
                            Content="Afficher les clients archivés"
                            IsChecked="{Binding m_is_show_archived_checked, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Margin="0,0,50,0"
                            FontSize="16">
                            
                        </CheckBox>
                        
                        <!--List of the clients-->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <ListView 
                                Grid.Column="1" 
                                Margin="0,0,0,10"
                                FontSize="14"
                                MinWidth="500"
                                ItemsSource="{Binding m_list_items}"
                                SelectedItem="{Binding m_selected_item}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding entity_id}"/>
                                        <GridViewColumn Header="Nom" DisplayMemberBinding="{Binding entity_name}"/>
                                        <GridViewColumn Header="Téléphone" DisplayMemberBinding="{Binding entity_phone}"/>
                                        <GridViewColumn Header="Email" DisplayMemberBinding="{Binding entity_email}"/>
                                        <GridViewColumn Header="Ville" DisplayMemberBinding="{Binding entity_city}"/>
                                        <GridViewColumn Header="Adresse" DisplayMemberBinding="{Binding entity_address}"/>
                                        <GridViewColumn Header="Archivé" DisplayMemberBinding="{Binding entity_archive}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!--Delete Buttons-->
                        <Button 
                            Grid.Row="2"
                            Content="{Binding m_delete_button_text}"
                            Command="{Binding m_delete_item_command}"
                            Height="30" Width="130"
                            MaxHeight="30" MaxWidth="130"
                            HorizontalAlignment="left" VerticalAlignment="Center"
                            Margin="50,0,0,0"
                            FontSize="16"
                            Background="IndianRed"
                        ></Button>

                        <!--Modifiy Buttons-->
                        <Button 
                            Grid.Row="2"
                            Content="Modifier"
                            Command="{Binding m_modify_item_command}"
                            Height="30" Width="130"
                            MaxHeight="30" MaxWidth="130"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,200,0"
                            FontSize="16"
                        ></Button>

                        <!--Add new Client Buttons-->
                        <Button 
                            Grid.Row="2"
                            Content="Nouveau client"
                            Command="{Binding m_add_new_item_command}"
                            Height="30" Width="130"
                            MaxHeight="30" MaxWidth="130"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,50,0"
                            FontSize="16"
                        ></Button>
                    </Grid>
                </Grid>
                <!--Content-->
            </Grid>
            <!--Body-->

            <!--Footer-->
            <userControls:UCFooter x:Name="footer" Grid.Row="2">

            </userControls:UCFooter>
            <!--Footer-->
        </Grid>
        <!--Page-->
    </Grid>
</Page>
