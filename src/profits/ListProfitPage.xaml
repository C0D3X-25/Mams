<Page x:Class="Mams.src.profits.ListProfitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Mams.src.profits"
      xmlns:userControls="clr-namespace:Mams.src.views.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1224"
      Title="ListProfitPage">

    <Grid Background="{Binding m_page_background_color}">
        <!--Page is 12* per 12*-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" MaxHeight="100"/>
                <RowDefinition Height="9*"/>
                <RowDefinition Height="1*" MaxHeight="50"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*"/>
            </Grid.ColumnDefinitions>

            <!--Header-->
            <userControls:UCHeader 
            Grid.Row="0"
            title="Liste des Profits">

            </userControls:UCHeader>

            <!--Body-->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MaxWidth="200"/>
                    <!--For menu-->
                    <ColumnDefinition Width="10*"/>
                    <!--For content-->
                </Grid.ColumnDefinitions>

                <!--Menu-->
                <userControls:UCMenu>

                </userControls:UCMenu>

                <!--Content-->
                <Grid 
                    Grid.Column="1" 
                    Background="{Binding m_body_background_color}" 
                    Margin="3,3,10,3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="10*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!--List of Product-->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <ListView 
                            Grid.Column="1" 
                            Margin="0,0,0,10"
                            MinWidth="500"
                            FontSize="14"
                            ItemsSource="{Binding m_list_items}"
                            SelectedItem="{Binding m_selected_item}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="N°" DisplayMemberBinding="{Binding receipt.receipt_id}"/>
                                        <GridViewColumn Header="Client" DisplayMemberBinding="{Binding entity.entity_name}"/>
                                        <GridViewColumn Header="Date" DisplayMemberBinding="{Binding receipt.receipt_date_created}"/>
                                        <GridViewColumn Header="Prix Total" DisplayMemberBinding="{Binding receipt.receipt_total_price}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!--Delete Buttons-->
                        <Button 
                            Grid.Row="2"
                            Content="Supprimer"
                            Command="{Binding m_delete_item_command}"
                            Height="30" Width="130"
                            MaxHeight="30" MaxWidth="130"
                            HorizontalAlignment="left" VerticalAlignment="Center"
                            Margin="50,0,0,0"
                            FontSize="16"
                            Background="{Binding m_delete_button_color}"
                            Foreground="{Binding m_delete_button_text_color}"
                        ></Button>

                        <!--Modifiy Buttons-->
                        <Button 
                            Grid.Row="2"
                            Content="Modifier"
                            Command="{Binding m_modify_item_command}"
                            Height="30" Width="130"
                            MaxHeight="30" MaxWidth="130"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,200,0"
                            FontSize="16"
                            Background="{Binding m_button_color}"
                            Foreground="{Binding m_button_text_color}"                            
                        ></Button>

                        <!--Add new Product Buttons-->
                        <Button 
                            Grid.Row="2"
                            Content="Nouveau Profit"
                            Command="{Binding m_add_new_item_command}"
                            Height="30" Width="130"
                            MaxHeight="30" MaxWidth="130"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,50,0"
                            FontSize="16"
                            Background="{Binding m_button_color}"
                            Foreground="{Binding m_button_text_color}"                            
                        ></Button>
                    </Grid>
                </Grid>
            </Grid>

            <!--Footer-->
            <userControls:UCFooter 
                Grid.Row="2"

            ></userControls:UCFooter>
        </Grid>
    </Grid>
</Page>
